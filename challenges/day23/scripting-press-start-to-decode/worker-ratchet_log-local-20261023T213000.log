th-leaf.\nPF_ID = re.compile(r\"^(?P<fam>.+?)-(?P<stem>[0-9a-f]{6})-(?P<field>[a-z][a-z0-9-]*)$\")\nINDICATOR_ORDER = (\"url\", \"upload_url\", \"next_stage\", \"file_path\", \"schedule_path\", \"note_name\", \"recovery_note\",\n                   \"host_id\")\nPS_BY_SCENARIO = {\"resource_hijacking\": (\"wallet\", \"mutex\"), \"synthetic_collection\": (\"file\", \"agent\"),\n                  \"synthetic_impact\": (\"note\", \"extension\")}\n\n\ndef pf_field(aid, member):\n    m = PF_ID.match(aid)\n    if not m or Path(member).stem.lower() != m.group(\"stem\"):\n        return None\n    return m.group(\"fam\"), m.group(\"field\")\n\n\ndef _pv(o, k):\n    v = o.get(\"ind:\" + k)\n    return o.get(k) if v is None else v\n\n\ndef _join(*vals):\n    return \"|\".join(str(v) for v in vals) if all(v not in (None, \"\") for v in vals) else None\n\n\ndef _steps(o):\n    v = o.get(\"steps\") or _pv(o, \"steps\")\n    if isinstance(v, (list, tuple)):\n        v = \">\".join(v)\n    return \">\".join(x for x in re.split(r\"[,>]\", v) if x) if v else None\n\n\ndef _handoff_id(artdir, member):\n    \"\"\"`$HandoffId = '..'` of the PowerShell precursor in the archive whose next stage names `member`.\"\"\"\n    _indexed(artdir, None, \"\")\n    for (parent, name), loads in _INDEX.get(str(artdir), {}).items():\n        if not name.lower().endswith((\".ps1\", \".psm1\")) or len(loads) != 1:\n            continue\n        t = loads[0]().decode(\"utf-8\", \"ignore\")\n        if member in t:\n            m = re.search(r\"\\$?HandoffId\\s*=\\s*['\\\"]([^'\\\"]+)['\\\"]\", t, re.I)\n            if m:\n                return m.group(1)\n    return None\n\n\ndef pf_value(o, fam, field, kind, artdir, member):\n    fam = fam.split(\"-\")[0]\n    if field == \"campaign-token\":\n        c = o.get(\"campaign\") or _pv(o, \"campaign_id\")\n        return c.split(\"-\", 1)[1] if c and \"-\" in c else None\n    if field == \"campaign\":\n        return o.get(\"campaign\") or _pv(o, \"campaign_id\")\n    if field == \"steps\":\n        return _steps(o)\n    if field == \"indicator\":\n        return next((_pv(o, k) for k in INDICATOR_ORDER if _pv(o, k)), None)\n    if field == \"url-host\":\n        from urllib.parse import urlsplit\n        u = _pv(o, \"url\")\n        return urlsplit(u).hostname if u else None\n    if field == \"path-leaf\":\n        p = _pv(o, \"file_path\")\n        return re.split(r\"[\\\\/]\", p)[-1] if p else None\n    if field == \"handoff-id\":\n        return _handoff_id(artdir, member)\n    if kind == \"ps\" and field in (\"secondary\", \"tertiary\"):\n        pair = PS_BY_SCENARIO.get(o.get(\"scenario\"))\n        return o.get(pair[field == \"tertiary\"]) if pair else None\n    if field == \"style\":\n        if kind == \"js\":\n            return _join(o.get(\"function-style\"), o.get(\"invocation-style\"), o.get(\"property-style\"))\n        if kind == \"bat\":\n            exp = (o.get(\"expansion_style\") or o.get(\"expansion_stmt\")) if (CONTRACT.get(\"run_for_time\") is False or str(\n                CONTRACT.get(\"started_at\") or \"\")[:10] >= \"2026-10-16\") else o.get(\"expansion\")\n            return _join(o.get(\"graph\"), o.get(\"control\"), exp)\n        if kind == \"vbs\":\n            return _join(o.get(\"representation\"), o.get(\"transform\"), o.get(\"control\"))\n    if kind == \"py\" and field == \"carrier\":\n        return _join(o.get(\"carrier\"), o.get(\"windows-chain\"))\n    if kind == \"py\" and field == \"obfuscation\":\n        return _join(o.get(\"syntax\"), o.get(\"obfuscation\"))\n    v = o.get(field)\n    return _pv(o, field.replace(\"-\", \"_\")) if v is None else v\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--contract\", required=True)\n    ap.add_argument(\"--artifacts\", required=True)\n    a = ap.parse_args()\n    contract, pairs = load_contract(a.contract)\n    CONTRACT.update(contract)\n    # A GM error body saved as the artifact (attempt 26b7da83: '{\"error\":\"rate_limited\"}' as evidence.zip) has no\n    # bytes to answer from: fail loudly instead of emitting default role/attack guesses for a third of the fields.\n    files = [p for p in Path(a.artifacts).rglob(\"*\") if p.is_file()]\n    bodies = [p.read_bytes() for p in files if p.stat().st_size < 512]\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:332:    wrapped in `if defined` (that variant is labelled `call_double`).\"\"\"\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:343:            # GM-verified over ~100 timed cases: the generator's call_double template is the one that uses the h\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:347:            # D16 Mastery 7fbfc526/81bb44e6: h-pool FOR call_double rejected -> for_indirect).\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:350:            return \"call_double\" if pref == \"h\" else \"for_indirect\"\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:352:            # `call set \"cfg=%%h0%%...\"` (h fragment pool) = call_double; other pools (FrAg/fragment/v_a) = delayed.\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:353:            return \"call_double\"\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:358:                # call_double on any pool (TT b10c4da4 GM-verified, FrAg pool); the older `-expansion` field keeps\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:360:                return \"call_double\"\nchallenges/day23/scripting-press-start-to-decode/solver/batchplan.py:365:            return \"call_double\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NgFjgzc9KUQv92X1XkVLF3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
