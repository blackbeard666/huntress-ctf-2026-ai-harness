K.finditer(data)] + cands\n    # Day 19 (C# script embedded as an escaped string in an ASPX host): `\\n` / `\\\"` escapes wrap the marker/descriptor.\n    if '\\\\\"' in text or \"\\\\n\" in text:\n        text = text.replace('\\\\\"', '\"').replace(\"\\\\n\", \"\\n\")\n        cands = [m.group(1).decode() + \"-\" + m.group(2).decode() for m in V3_MARK.finditer(text.encode())] + cands\n        cands += [m.group(2).decode() for m in V3_MARK.finditer(text.encode())]\n    for m in re.finditer(r\"descriptor_\\w*\\s*=\\s*((?:\\\"[^\\\"]*\\\"|'[^']*'|\\s*[.+&]\\s*|\\s*_\\s*\\n)+)\", text):\n        cands.append(\"\".join(re.findall(r\"\\\"([^\\\"]*)\\\"|'([^']*)'\", m.group(1)) and\n                             [a or b for a, b in re.findall(r\"\\\"([^\\\"]*)\\\"|'([^']*)'\", m.group(1))]))\n    # Day 18 (Google Apps Script): `// HUNTRESS_ANALYSIS_V1:SPLIT` + `const X = [\"<TAG>-chunk\", \"chunk\", ..].join(\"\")`\n    # (and an untagged copy in buildAnalysisPlan_). Join every all-literal array / concat run, drop the `<TAG>-` head.\n    for m in re.finditer(r\"\\[\\s*((?:(?:\\\"[^\\\"]*\\\"|'[^']*'|`[^`$]*`)\\s*,?\\s*)+)\\]\", text):\n        lits = re.findall(r\"\\\"([^\\\"]*)\\\"|'([^']*)'|`([^`$]*)`\", m.group(1))\n        j = \"\".join(a or b or c for a, b, c in lits)\n        if len(j) >= 16:\n            cands.append(j)\n            cands.append(re.sub(r\"^[A-Za-z0-9_]{1,12}-\", \"\", j))\n    plan = {}\n    for c in cands:\n        pl = _lyr_peel(c) or _v3_peel(c)\n        if pl:\n            plan = codec.plan_kv(pl)\n            if plan.get(\"steps\") or plan.get(\"role\"):\n                break\n    if not plan:\n        plan = fallback_plan(text)\n    log(member, json.dumps(plan))\n    steps = [x for x in re.split(r\"[,>]\", plan.get(\"steps\") or \"\") if x]\n    role = plan.get(\"role\") or sh_role(steps, plan)\n    att = plan.get(\"attack\") or ROLE_ATTACK.get(role)\n    out = {\"role\": role, \"attack\": att, \"adapter\": plan.get(\"adapter\"), \"campaign\"