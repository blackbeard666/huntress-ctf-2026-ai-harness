_cli_metadata(data)\\n    if not md:\\n        return None\\n    _, st = md\\n    tbl = st.get(\\\"#~\\\") or st.get(\\\"#-\\\")\\n    gh = st.get(\\\"#GUID\\\")\\n    if not tbl or not gh:\\n        return None\\n    t = tbl[0]\\n    heap_sizes = data[t + 6]\\n    valid, = struct.unpack_from(\\\"<Q\\\", data, t + 8)\\n    if not valid & 1:\\n        return None\\n    rows_at = t + 24\\n    p = rows_at + 4 * bin(valid).count(\\\"1\\\")\\n    if heap_sizes & 0x20:  # extra data (#- uncompressed)\\n        p += 4\\n    sidx = 4 if heap_sizes & 1 else 2\\n    gidx = 4 if heap_sizes & 2 else 2\\n","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AVCF9Anh4sqPWsbGtX9E6q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
