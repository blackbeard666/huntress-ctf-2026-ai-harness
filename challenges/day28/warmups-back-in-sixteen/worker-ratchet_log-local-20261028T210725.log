ecode each chunk with decode_chunk / DAYS decoders, join verbatim (no strip), slug gate; fall back to a DP over split points when no separators. Fixtures: the crib sentence cut into 5-10 chunks in random seen codecs, with and without newlines.\"},\n]\ngi=[x['id'] for x in g]\nassert not set(gi)&{x['id'] for x in new}\ng=new+g\ng.sort(key=lambda x:x['priority'])\nbody=\"[\\n\"+\",\\n\".join(\"  \"+json.dumps(x,ensure_ascii=False) for x in g)+\"\\n]\"\nt=t[:m.start(2)]+body+t[m.end(2):]\nopen(p,'w').write(t)\nEOF\nF=reference/coverage/warmups.md; python3 - <<'EOF'\nimport json,re\nt=open('reference/coverage/warmups.md').read()\ng=json.loads(re.search(r\"## Readiness gaps\\n\\n```json\\n(.*?)\\n```\",t,re.S).group(1))\nst=json.load(open('.run/prebuild-state.json'))\npend=[x['id'] for x in g if x['action']=='prebuild' and not ((s:=st.get('warmups:'+x['id'])) and (s.get('ok') or s.get('attempts',0)>=2))]\nprint(len(g),len(pend),pend)\nprint(all(set(x)=={'id','concept','priority','action','detail'} for x in g))\ns=t.index(\"## Recognition cues (worker quick-reference)\"); e=t.index(\"## Readiness gaps\")\nprint(\"cue lines\", t[s:e].strip().count(\"\\n\")+1)\nEOF\nhead -c 0 $F"}}}
