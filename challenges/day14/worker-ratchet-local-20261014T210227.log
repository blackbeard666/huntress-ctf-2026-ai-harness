{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016y5EydDdqYBguuMM2eNVsk","type":"tool_result","content":"\"\"\"Warmups lane codec library: every day's line codec as an exact ENCODER + decoder, plus a broad try-list of classical\nencoders for identifying an unknown day's codec from its Single Solve.\n\nWarmups (D1-D13): each Single is one sentence -- \"Nice work decoding this warmup! To solve, submit this exact answer to\nthe Game Master: <slug>\" -- under ONE codec that changes daily; Mastery day N = 5N-2 sets of N numbered lines, line k\nunder day k's codec, the sentence cut mid-word (reference/techniques/warmups.md). The encoders below reproduce the GM's\nbytes exactly (all 819 lines of D13 auto-mastery-d1a77831: lowercase hex/%xx, space-separated 8-bit binary, decimal,\n3-digit octal, decimal `&#NN;`, quoted lowercase `\\\\u00xx`, padded base32, unpadded base64url, ...), so\nhctf/today_probe.py can re-encode yesterday's verified Mastery sentence with TODAY's codec on a new last line and test\nthe solver BEFORE the Mastery clock (D12/D13: the first Mastery attempt failed on exactly that mix).\n\n  DAYS        [(day, name, enc, dec, free)] -- free = no alphabet signature (told apart only by how English it reads)\n  CANDIDATES  [(name, enc, dec|None)] -- DAYS first, then format variants, classical ciphers and chained pairs\n  infer(plain, blob, hints=())  -> (name, enc) | None: the encoder E with E(plain) == blob.strip() (or dec(blob) == plain)\n  plaintext(blob, slug)         -> the decoded sentence (decode_chunk -> peel -> candidate decoders -> template)\n\nAlso registers SPECULATIVE keyless free-text decoders with lib.decode.register_free (day=None): lib.decode's joint\nfree-line assignment tries them only for a blob with more free lines than the confirmed free codecs cover AND more lines\nthan the newest confirmed codec's day -- never on D1-D13 bytes. Pure stdlib.\n\"\"\"\nimport base64\nimport codecs\nimport html\nimport itertools\nimport json\nimport quopri\nimport os\nimport re\nimport string\nimport urllib.parse\n\nSENTENCE = \"Nice work decoding this warmup! To solve, submit this exact answer to the Game Master: {slug}\"\nSLUG = re.compile(r\"[a-z]+(?:-[a-z]+)+-\\d{2,}\")\n\n\ndef _u(s):\n    return s.encode(\"utf-8\")\n\n\ndef _t(b):\n    return b.decode(\"utf-8\") if isinstance(b, (bytes, bytearray)) else b\n\n\n# ------------------------------------------------------------------------------------------------ day codecs (exact)\ndef rot(s, n):\n    return \"\".join(chr((ord(c) - 97 + n) % 26 + 97) if \"a\" <= c <= \"z\" else\n                   chr((ord(c) - 65 + n) % 26 + 65) if \"A\" <= c <= \"Z\" else c for c in s)\n\n\ndef atbash(s):\n    return \"\".join(chr(219 - ord(c)) if \"a\" <= c <= \"z\" else chr(155 - ord(c)) if \"A\" <= c <= \"Z\" else c for c in s)\n\n\ndef _b64pad(t):\n    t = re.sub(r\"\\s+\", \"\", t)\n    return t + \"=\" * (-len(t) % 4)\n\n\ndef _toks(t):\n    return [x for x in re.split(r\"[\\s,]+\", t.strip()) if x]\n\n\nDAYS = [\n    (1, \"base64\", lambda s: base64.b64encode(_u(s)).decode(), lambda t: _t(base64.b64decode(_b64pad(t), validate=True)),\n     False),\n    (2, \"rot13\", lambda s: rot(s, 13), lambda t: rot(t, 13), True),\n    (3, \"hex\", lambda s: _u(s).hex(), lambda t: _t(bytes.fromhex(re.sub(r\"\\s+\", \"\", t))), False),\n    (4, \"binary8\", lambda s: \" \".join(f\"{b:08b}\" for b in _u(s)),\n     lambda t: _t(bytes(int(x, 2) for x in _toks(t))), False),\n    (5, \"decimal\", lambda s: \" \".join(str(b) for b in _u(s)), lambda t: _t(bytes(int(x) for x in _toks(t))), False),\n    (6, \"octal3\", lambda s: \" \".join(f\"{b:03o}\" for b in _u(s)), lambda t: _t(bytes(int(x, 8) for x in _toks(t))),\n     False),\n    (7, \"url%xx\", lambda s: \"\".join(f\"%{b:02x}\" for b in _u(s)), lambda t: _t(urllib.parse.unquote_to_bytes(t.strip())),\n     False),\n    (8, \"html&#n;\", lambda s: \"\".join(f\"&#{ord(c)};\" for c in s), lambda t: html.unescape(t.strip()), False),\n    (9, \"json\\\\u\", lambda s: '\"' + \"\".join(f\"\\\\u{ord(c):04x}\" for c in s) + '\"',\n     lambda t: json.loads(t.strip() if t.strip().startswith('\"') else '\"' + t.strip() + '\"'), False),\n    (10, \"base32\", lambda s: base64.b32encode(_u(s)).decode(), lambda t: _t(base64.b32decode(re.sub(r\"\\s+\", \"\", t))),\n     False),\n    (11, \"base64url-nopad\", lambda s: base64.urlsafe_b64encode(_u(s)).decode().rstrip(\"=\"),\n     lambda t: _t(base64.urlsafe_b64decode(_b64pad(t.strip().rstrip(\"=\")))), False),\n    (12, \"reverse\", lambda s: s[::-1], lambda t: t[::-1], True),\n    (13, \"atbash\", atbash, atbash, True),\n]\n\ntry:   # fair runs (HCTF_CODEC_MAX_DAY=<N-1>, as lib/codec.py): only codecs GM-confirmed before day N\n    _MAXD = int(os.environ.get(\"HCTF_CODEC_MAX_DAY\", \"0\")) or 99\nexcept ValueError:\n    _MAXD = 99\nDAYS = [d for d in DAYS if d[0] <= _MAXD]\n\n\ndef day_codec(day):\n    \"\"\"(name, enc, dec, free) of a known day's line codec, or None.\"\"\"\n    for d, name, enc, dec, free in DAYS:\n        if d == day:\n            return name, enc, dec, free\n    return None\n\n\n#!/usr/bin/env python3\n\"\"\"Solver for this challenge -- harness skeleton. Fill in `answer()`; keep the I/O contract unchanged.\n\n    solve.py --contract <contract.json> --artifacts <dir>   ->  prints {answer_id: value} as JSON on the last line\n\nRuns on the Homebase VM inside a ~6-7 s window for EVERY Mastery set: stdlib + lib.* + pyzipper/pyelftools/pefile/\ncapstone/pycryptodome/androguard only, no subprocess to 7z/jadx/etc., all sets well under 1 s. Mastery questions name\ntheir files like 'delivery 2: sample_02.apk' or 'evidence.zip -> member': `artifact_bytes()` resolves both (by sha256\npairing first, so same-named per-set deliveries never get mixed up).\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[4]\nsys.path.insert(0, str(ROOT))\nimport lib.decode as _dec  # noqa: E402\nfrom lib.common import (container_by_sha, delivery_missing, find_artifact, group_by_set, load_contract,  # noqa: E402\n                        normalize)\n\n_cache = {}\n\n\ndef artifact_bytes(root, contract, artifact):\n    \"\"\"Bytes for a question's `artifact` string (cached per artifact).\"\"\"\n    if artifact in _cache:\n        return _cache[artifact]\n    container, _, member = (x.strip() for x in artifact.partition(\"->\"))\n    data = None\n    p = container_by_sha(root, contract, container)\n    if p is not None and not member:\n        data = p.read_bytes()\n    elif not delivery_missing(root, contract, container):\n        for cand in (artifact, container.split(\": \", 1)[-1] + (f\" -> {member}\" if member else \"\")):\n            try:\n                data = find_artifact(root, cand)\n                break\n            except FileNotFoundError:\n                continue\n    _cache[artifact] = data\n    return data\n\n\n# Day 14 \"Seven Steps\" (\"Caesar took a week off\"): a fixed Caesar shift of +7 (decode = rot19). In a Mastery blob it is\n# line 14's free-text codec next to rot13 (line 2), reversal (12) and Atbash (13): lib.decode.decode_chunked assigns\n# each free codec once per blob, so register it there (proposed for lib in NOTES.md).\n_dec.register_free(\"caesar7\", 14, lambda p: [_dec._rot(p, -7)])\n\nSLUG = re.compile(r\"[a-z]+-[a-z]+-[a-z]+-\\d{2}\")\n_CH = re.compile(r\"^(\\d+)\\t(.*)$\")\n\n\ndef _atbash(s):\n    return \"\".join(chr(219 - ord(c)) if \"a\" <= c <= \"z\" else chr(155 - ord(c)) if \"A\" <= c <= \"Z\" else c for c in s)\n\n\ndef _chunk(p, k=None):\n    \"\"\"decode_chunk + Atbash (Day 13 \"Opposite Day\": a<->z mirror, digits/punctuation kept). Atbash competes only\n    with free-text results (rot-N / reversal of the raw line); line 13 of a numbered blob leans Atbash.\"\"\"\n    d = _dec.decode_chunk(p)\n    t = p.strip()\n    if not re.search(r\"[A-Za-z]\", t):\n        return d\n    free = d is not None and (d.strip() == t[::-1] or any(d == _dec._rot(p, n) for n in range(26)))\n    if not free:\n        return d\n    a = _atbash(p)\n    if re.fullmatch(r\"\\d{2,}-[A-Za-z][A-Za-z-]*\", t):  # reversed slug tail (Day 12) -- unless it's line 13\n        return a if k == 13 else d\n    bonus = 0.6 if k == 13 else (-0.6 if k in (2, 12) else 0.0)\n    return a if _dec._bigram(a) + bonus > _dec._bigram(d) else d\n\n\ndef _is_free(p):\n    \"\"\"A letter-bearing fragment no strict codec claims: decode_chunk fell through to rot-N / reversal.\"\"\"\n    t = p.strip()\n    if not re.search(r\"[A-Za-z]\", t):\n        return False\n    d = _dec.decode_chunk(p)\n    return d is not None and (d.strip() == t[::-1] or d == _atbash(p) or any(d == _dec._rot(p, n) for n in range(26)))\n\n\ndef _joint(rows):\n    \"\"\"Mastery line k = day k's encoding; the free-text days are rot-N (D2), reversal (D12) and Atbash (D13), each\n    used ONCE per blob, plus Caesar+7 (D14) as a second, fixed rot. Decode by alphabet, not position: try every assignment of those transforms to the free\n    lines (reversal offered only to a blob of >= 12 lines, Atbash >= 13) and keep the one whose joined text ends in\n    a slug, then reads most like English. Per-line guessing put Atbash on '-tliuq-d' (-> 'd-quilt-').\"\"\"\n    kmax = max(k for k, _ in rows)\n    free = [i for i, (_, p) in enumerate(rows) if _is_free(p)]\n    if not free or len(free) > 4:\n        return None\n    fixed = [_dec.decode_chunk(p) if i not in free else None for i, (_, p) in enumerate(rows)]\n    if any(x is None for i, x in enumerate(fixed) if i not in free):\n        return None\n    tf = ([(\"rot\", None)] + ([(\"rev\", None)] if kmax >= 12 else []) + ([(\"atb\", None)] if kmax >= 13 else [])\n          + ([(\"c7\", None)] if kmax >= 14 else []))\n    import itertools\n\n    def cand(name, p):\n        if name == \"rev\":\n            return [p.strip()[::-1] if p.strip() == p else p[::-1]]\n        if name == \"atb\":\n            return [_atbash(p)]\n        if name == \"c7\":\n            return [_dec._rot(p, -7)]\n        return [_dec._best_rot(p)] + ([_dec._rot(p, 13)] if _dec._rot(p, 13) != _dec._best_rot(p) else [])\n\n    best = None\n    names = [n for n, _ in tf]\n    for combo in itertools.product(names, repeat=len(free)):\n        if len(set(combo)) < len(combo):\n            continue\n        for picks in itertools.product(*(cand(n, rows[i][1]) for n, i in zip(combo, free))):\n            parts = list(fixed)\n            for i, v in zip(free, picks):\n                parts[i] = v\n            text = \"\".join(parts)\n            last = [ln for ln in text.splitlines() if ln.strip()]\n            ok = bool(last) and re.search(SLUG.pattern + r\"\\s*$\", last[-1]) is not None\n            sc = (ok, _dec._bigram(text))\n            if best is None or sc > best[0]:\n                best = (sc, text)\n    return best[1] if best and best[0][0] else None\n\n\ndef _decode_text(txt):\n    rows = []\n    for ln in txt.splitlines():\n        m = _CH.match(ln.rstrip(\"\\r\\n\"))\n        if m:\n            rows.append((int(m.group(1)), m.group(2)))\n        elif ln.strip():\n            rows = None\n            break\n    if rows and len(rows) >= 2:\n        rows.sort(key=lambda r: r[0])\n        j = _dec.decode_chunked(txt)\n        if j is not None and _slug(j):\n            return j\n        j = _joint(rows)\n        if j is not None:\n            return j\n        return \"\".join(_chunk(p, k) for k, p in rows)\n    return _chunk(txt)\n\n\ndef _slug(text):\n    if not text:\n        return None\n    lines = [ln for ln in text.splitlines() if ln.strip()]\n    for ln in reversed(lines):\n        m = SLUG.findall(ln)\n        if m:\n            return m[-1]\n    m = SLUG.findall(text)\n    return m[-1] if m else None\n\n\ndef answer(answer_id, question, data, contract):\n    \"\"\"Return the value for one answer_id from its artifact bytes (None = cannot answer). Derive everything from\n    `data`; never hard-code a variant's values.\"\"\"\n    if not data:\n        return None\n    if data[:4] == b\"PK\\x03\\x04\":\n        return None\n    txt = data.decode(\"utf-8\", \"replace\")\n    return _slug(_decode_text(txt))\n\n\ndef fallback(answer_id, question, data, contract):\n    \"\"\"Called ONLY when answer() found nothing (None or an exception): a cheap generic second try for a variant shape\n    the direct parse doesn't know (Time Trial / Mastery mutate the task) -- e.g. the lane lib's name-agnostic decoder\n    over `data`, then a match against question[\"answer_format\"]. None = give up on this field only.\"\"\"\n    if not data:\n        return None\n    txt = data.decode(\"utf-8\", \"replace\")\n    for cand in (_dec.decode_chunked(txt), _dec.decode_chunk(txt), _atbash(txt), txt[::-1]):\n        v = _slug(cand)\n        if v:\n            return v\n    return None\n\n\ndef _past_deadline():\n    \"\"\"The timed runner's HCTF_SOLVE_DEADLINE (epoch) has passed: print the answers found so far instead.\"\"\"\n    try:\n        return time.time() > float(os.environ[\"HCTF_SOLVE_DEADLINE\"])\n    except (KeyError, ValueError):\n        return False\n\n\ndef _solve_pairs(job):\n    \"\"\"Answer one group of (answer_id, question) pairs -- a whole Mastery set, or the whole contract.\"\"\"\n    root, contract, pairs = job\n    out = {}\n    for aid, q in pairs:\n        data = artifact_bytes(root, contract, q.get(\"artifact\") or \"\")\n        try:\n            v = answer(aid, q, data, contract)\n        except Exception as e:  # noqa: BLE001 - one bad field must not sink the other answers\n            print(f\"{aid}: {e!r}\", file=sys.stderr)\n            v = None\n        if v is None and not _past_deadline():   # in-window: never let a fallback search eat the kill margin\n            try:\n                v = fallback(aid, q, data, contract)\n            except Exception as e:  # noqa: BLE001\n                print(f\"{aid}: fallback {e!r}\", file=sys.stderr)\n        if v is not None:\n            out[aid] = normalize(v, q)\n    return out\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--contract\", required=True)\n    ap.add_argument(\"--artifacts\", required=True)\n    a = ap.parse_args()\n    contract, pairs = load_contract(a.contract)\n    groups = group_by_set(pairs)\n    out = {}\n    if len(groups) >= 2 and os.environ.get(\"HCTF_SOLVER_PARALLEL\", \"1\") != \"0\":\n        # Mastery: every set runs inside ONE clock -- one forked process per set (the Homebase VM has 2 vCPUs; heavy\n        # per-set work such as unzipping 31 MB deliveries halves). Same results as the sequential loop.\n        import multiprocessing as mp\n        from concurrent.futures import ProcessPoolExecutor\n        try:\n            with ProcessPoolExecutor(max_workers=min(len(groups), os.cpu_count() or 2),\n                                     mp_context=mp.get_context(\"fork\")) as ex:\n                for part in ex.map(_solve_pairs, [(a.artifacts, contract, g) for g in groups.values()]):\n                    out.update(part)\n        except Exception as e:  # noqa: BLE001 - never lose a solve to the pool: fall back to sequential\n            print(f\"parallel sets failed ({e!r}); sequential\", file=sys.stderr)\n            out = _solve_pairs((a.artifacts, contract, pairs))\n    else:\n        out = _solve_pairs((a.artifacts, contract, pairs))\n    print(json.dumps(out))\n\n\nif __name__ == \"__main__\":\n    main()","is_error":false}]},"parent_tool_use_id":null,"session_id":"7c15d1ac-3029-4a6e-a501-11867199be60","uuid":"e77efd63-ff5d-455d-b5eb-32733807513d","timestamp":"2026-10-14T13:04:37.193Z","tool_use_result":{"stdout":"\"\"\"Warmups lane codec library: every day's line codec as an exact ENCODER + decoder, plus a broad try-list of classical\nencoders for identifying an unknown day's codec from its Single Solve.\n\nWarmups (D1-D13): each Single is one sentence -- \"Nice work decoding this warmup! To solve, submit this exact answer to\nthe Game Master: <slug>\" -- under ONE codec that changes daily; Mastery day N = 5N-2 sets of N numbered lines, line k\nunder day k's codec, the sentence cut mid-word (reference/techniques/warmups.md). The encoders below reproduce the GM's\nbytes exactly (all 819 lines of D13 auto-mastery-d1a77831: lowercase hex/%xx, space-separated 8-bit binary, decimal,\n3-digit octal, decimal `&#NN;`, quoted lowercase `\\\\u00xx`, padded base32, unpadded base64url, ...), so\nhctf/today_probe.py can re-encode yesterday's verified Mastery sentence with TODAY's codec on a new last line and test\nthe solver BEFORE the Mastery clock (D12/D13: the first Mastery attempt failed on exactly that mix).\n\n  DAYS        [(day, name, enc, dec, free)] -- free = no alphabet signature (told apart only by how English it reads)\n  CANDIDATES  [(name, enc, dec|None)] -- DAYS first, then format variants, classical ciphers and chained pairs\n  infer(plain, blob, hints=())  -> (name, enc) | None: the encoder E with E(plain) == blob.strip() (or dec(blob) == plain)\n  plaintext(blob, slug)         -> the decoded sentence (decode_chunk -> peel -> candidate decoders -> template)\n\nAlso registers SPECULATIVE keyless free-text decoders with lib.decode.register_free (day=None): lib.decode's joint\nfree-line assignment tries them only for a blob with more free lines than the confirmed free codecs cover AND more lines\nthan the newest confirmed codec's day -- never on D1-D13 bytes. Pure stdlib.\n\"\"\"\nimport base64\nimport codecs\nimport html\nimport itertools\nimport json\nimport quopri\nimport os\nimport re\nimport string\nimport urllib.parse\n\nSENTENCE = \"Nice work decoding this warmup! To solve, submit this exact answer to the Game Master: {slug}\"\nSLUG = re.compile(r\"[a-z]+(?:-[a-z]+)+-\\d{2,}\")\n\n\ndef _u(s):\n    return s.encode(\"utf-8\")\n\n\ndef _t(b):\n    return b.decode(\"utf-8\") if isinstance(b, (bytes, bytearray)) else b\n\n\n# ------------------------------------------------------------------------------------------------ day codecs (exact)\ndef rot(s, n):\n    return \"\".join(chr((ord(c) - 97 + n) % 26 + 97) if \"a\" <= c <= \"z\" else\n                   chr((ord(c) - 65 + n) % 26 + 65) if \"A\" <= c <= \"Z\" else c for c in s)\n\n\ndef atbash(s):\n    return \"\".join(chr(219 - ord(c)) if \"a\" <= c <= \"z\" else chr(155 - ord(c)) if \"A\" <= c <= \"Z\" else c for c in s)\n\n\ndef _b64pad(t):\n    t = re.sub(r\"\\s+\", \"\", t)\n    return t + \"=\" * (-len(t) % 4)\n\n\ndef _toks(t):\n    return [x for x in re.split(r\"[\\s,]+\", t.strip()) if x]\n\n\nDAYS = [\n    (1, \"base64\", lambda s: base64.b64encode(_u(s)).decode(), lambda t: _t(base64.b64decode(_b64pad(t), validate=True)),\n     False),\n    (2, \"rot13\", lambda s: rot(s, 13), lambda t: rot(t, 13), True),\n    (3, \"hex\", lambda s: _u(s).hex(), lambda t: _t(bytes.fromhex(re.sub(r\"\\s+\", \"\", t))), False),\n    (4, \"binary8\", lambda s: \" \".join(f\"{b:08b}\" for b in _u(s)),\n     lambda t: _t(bytes(int(x, 2) for x in _toks(t))), False),\n    (5, \"decimal\", lambda s: \" \".join(str(b) for b in _u(s)), lambda t: _t(bytes(int(x) for x in _toks(t))), False),\n    (6, \"octal3\", lambda s: \" \".join(f\"{b:03o}\" for b in _u(s)), lambda t: _t(bytes(int(x, 8) for x in _toks(t))),\n     False),\n    (7, \"url%xx\", lambda s: \"\".join(f\"%{b:02x}\" for b in _u(s)), lambda t: _t(urllib.parse.unquote_to_bytes(t.strip())),\n     False),\n    (8, \"html&#n;\", lambda s: \"\".join(f\"&#{ord(c)};\" for c in s), lambda t: html.unescape(t.strip()), False),\n    (9, \"json\\\\u\", lambda s: '\"' + \"\".join(f\"\\\\u{ord(c):04x}\" for c in s) + '\"',\n     lambda t: json.loads(t.strip() if t.strip().startswith('\"') else '\"' + t.strip() + '\"'), False),\n    (10, \"base32\", lambda s: base64.b32encode(_u(s)).decode(), lambda t: _t(base64.b32decode(re.sub(r\"\\s+\", \"\", t))),\n     False),\n    (11, \"base64url-nopad\", lambda s: base64.urlsafe_b64encode(_u(s)).decode().rstrip(\"=\"),\n     lambda t: _t(base64.urlsafe_b64decode(_b64pad(t.strip().rstrip(\"=\")))), False),\n    (12, \"reverse\", lambda s: s[::-1], lambda t: t[::-1], True),\n    (13, \"atbash\", atbash, atbash, True),\n]\n\ntry:   # fair runs (HCTF_CODEC_MAX_DAY=<N-1>, as lib/codec.py): only codecs GM-confirmed before day N\n    _MAXD = int(os.environ.get(\"HCTF_CODEC_MAX_DAY\", \"0\")) or 99\nexcept ValueError:\n    _MAXD = 99\nDAYS = [d for d in DAYS if d[0] <= _MAXD]\n\n\ndef day_codec(day):\n    \"\"\"(name, enc, dec, free) of a known day's line codec, or None.\"\"\"\n    for d, name, enc, dec, free in DAYS:\n        if d == day:\n            return name, enc, dec, free\n    return None\n\n\n#!/usr/bin/env python3\n\"\"\"Solver for this challenge -- harness skeleton. Fill in `answer()`; keep the I/O contract unchanged.\n\n    solve.py --contract <contract.json> --artifacts <dir>   ->  prints {answer_id: value} as JSON on the last line\n\nRuns on the Homebase VM inside a ~6-7 s window for EVERY Mastery set: stdlib + lib.* + pyzipper/pyelftools/pefile/\ncapstone/pycryptodome/androguard only, no subprocess to 7z/jadx/etc., all sets well under 1 s. Mastery questions name\ntheir files like 'delivery 2: sample_02.apk' or 'evidence.zip -> member': `artifact_bytes()` resolves both (by sha256\npairing first, so same-named per-set deliveries never get mixed up).\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[4]\nsys.path.insert(0, str(ROOT))\nimport lib.decode as _dec  # noqa: E402\nfrom lib.common import (container_by_sha, delivery_missing, find_artifact, group_by_set, load_contract,  # noqa: E402\n                        normalize)\n\n_cache = {}\n\n\ndef artifact_bytes(root, contract, artifact):\n    \"\"\"Bytes for a question's `artifact` string (cached per artifact).\"\"\"\n    if artifact in _cache:\n        return _cache[artifact]\n    container, _, member = (x.strip() for x in artifact.partition(\"->\"))\n    data = None\n    p = container_by_sha(root, contract, container)\n    if p is not None and not member:\n        data = p.read_bytes()\n    elif not delivery_missing(root, contract, container):\n        for cand in (artifact, container.split(\": \", 1)[-1] + (f\" -> {member}\" if member else \"\")):\n            try:\n                data = find_artifact(root, cand)\n                break\n            except FileNotFoundError:\n                continue\n    _cache[artifact] = data\n    return data\n\n\n# Day 14 \"Seven Steps\" (\"Caesar took a week off\"): a fixed Caesar shift of +7 (decode = rot19). In a Mastery blob it is\n# line 14's free-text codec next to rot13 (line 2), reversal (12) and Atbash (13): lib.decode.decode_chunked assigns\n# each free codec once per blob, so register it there (proposed for lib in NOTES.md).\n_dec.register_free(\"caesar7\", 14, lambda p: [_dec._rot(p, -7)])\n\nSLUG = re.compile(r\"[a-z]+-[a-z]+-[a-z]+-\\d{2}\")\n_CH = re.compile(r\"^(\\d+)\\t(.*)$\")\n\n\ndef _atbash(s):\n    return \"\".join(chr(219 - ord(c)) if \"a\" <= c <= \"z\" else chr(155 - ord(c)) if \"A\" <= c <= \"Z\" else c for c in s)\n\n\ndef _chunk(p, k=None):\n    \"\"\"decode_chunk + Atbash (Day 13 \"Opposite Day\": a<->z mirror, digits/punctuation kept). Atbash competes only\n    with free-text results (rot-N / reversal of the raw line); line 13 of a numbered blob leans Atbash.\"\"\"\n    d = _dec.decode_chunk(p)\n    t = p.strip()\n    if not re.search(r\"[A-Za-z]\", t):\n        return d\n    free = d is not None and (d.strip() == t[::-1] or any(d == _dec._rot(p, n) for n in range(26)))\n    if not free:\n        return d\n    a = _atbash(p)\n    if re.fullmatch(r\"\\d{2,}-[A-Za-z][A-Za-z-]*\", t):  # reversed slug tail (Day 12) -- unless it's line 13\n        return a if k == 13 else d\n    bonus = 0.6 if k == 13 else (-0.6 if k in (2, 12) else 0.0)\n    return a if _dec._bigram(a) + bonus > _dec._bigram(d) else d\n\n\ndef _is_free(p):\n    \"\"\"A letter-bearing fragment no strict codec claims: decode_chunk fell through to rot-N / reversal.\"\"\"\n    t = p.strip()\n    if not re.search(r\"[A-Za-z]\", t):\n        return False\n    d = _dec.decode_chunk(p)\n    return d is not None and (d.strip() == t[::-1] or d == _atbash(p) or any(d == _dec._rot(p, n) for n in range(26)))\n\n\ndef _joint(rows):\n    \"\"\"Mastery line k = day k's encoding; the free-text days are rot-N (D2), reversal (D12) and Atbash (D13), each\n    used ONCE per blob, plus Caesar+7 (D14) as a second, fixed rot. Decode by alphabet, not position: try every assignment of those transforms to the free\n    lines (reversal offered only to a blob of >= 12 lines, Atbash >= 13) and keep the one whose joined text ends in\n    a slug, then reads most like English. Per-line guessing put Atbash on '-tliuq-d' (-> 'd-quilt-').\"\"\"\n    kmax = max(k for k, _ in rows)\n    free = [i for i, (_, p) in enumerate(rows) if _is_free(p)]\n    if not free or len(free) > 4:\n        return None\n    fixed = [_dec.decode_chunk(p) if i not in free else None for i, (_, p) in enumerate(rows)]\n    if any(x is None for i, x in enumerate(fixed) if i not in free):\n        return None\n    tf = ([(\"rot\", None)] + ([(\"rev\", None)] if kmax >= 12 else []) + ([(\"atb\", None)] if kmax >= 13 else [])\n          + ([(\"c7\", None)] if kmax >= 14 else []))\n    import itertools\n\n    def cand(name, p):\n        if name == \"rev\":\n            return [p.strip()[::-1] if p.strip() == p else p[::-1]]\n        if name == \"atb\":\n            return [_atbash(p)]\n        if name == \"c7\":\n            return [_dec._rot(p, -7)]\n        return [_dec._best_rot(p)] + ([_dec._rot(p, 13)] if _dec._rot(p, 13) != _dec._best_rot(p) else [])\n\n    best = None\n    names = [n for n, _ in tf]\n    for combo in itertools.product(names, repeat=len(free)):\n        if len(set(combo)) < len(combo):\n            continue\n        for picks in itertools.product(*(cand(n, rows[i][1]) for n, i in zip(combo, free))):\n            parts = list(fixed)\n            for i, v in zip(free, picks):\n                parts[i] = v\n            text = \"\".join(parts)\n            last = [ln for ln in text.splitlines() if ln.strip()]\n            ok = bool(last) and re.search(SLUG.pattern + r\"\\s*$\", last[-1]) is not None\n            sc = (ok, _dec._bigram(text))\n            if best is None or sc > best[0]:\n                best = (sc, text)\n    return best[1] if best and best[0][0] else None\n\n\ndef _decode_text(txt):\n    rows = []\n    for ln in txt.splitlines():\n        m = _CH.match(ln.rstrip(\"\\r\\n\"))\n        if m:\n            rows.append((int(m.group(1)), m.group(2)))\n        elif ln.strip():\n            rows = None\n            break\n    if rows and len(rows) >= 2:\n        rows.sort(key=lambda r: r[0])\n        j = _dec.decode_chunked(txt)\n        if j is not None and _slug(j):\n            return j\n        j = _joint(rows)\n        if j is not None:\n            return j\n        return \"\".join(_chunk(p, k) for k, p in rows)\n    return _chunk(txt)\n\n\ndef _slug(text):\n    if not text:\n        return None\n    lines = [ln for ln in text.splitlines() if ln.strip()]\n    for ln in reversed(lines):\n        m = SLUG.findall(ln)\n        if m:\n            return m[-1]\n    m = SLUG.findall(text)\n    return m[-1] if m else None\n\n\ndef answer(answer_id, question, data, contract):\n    \"\"\"Return the value for one answer_id from its artifact bytes (None = cannot answer). Derive everything from\n    `data`; never hard-code a variant's values.\"\"\"\n    if not data:\n        return None\n    if data[:4] == b\"PK\\x03\\x04\":\n        return None\n    txt = data.decode(\"utf-8\", \"replace\")\n    return _slug(_decode_text(txt))\n\n\ndef fallback(answer_id, question, data, contract):\n    \"\"\"Called ONLY when answer() found nothing (None or an exception): a cheap generic second try for a variant shape\n    the direct parse doesn't know (Time Trial / Mastery mutate the task) -- e.g. the lane lib's name-agnostic decoder\n    over `data`, then a match against question[\"answer_format\"]. None = give up on this field only.\"\"\"\n    if not data:\n        return None\n    txt = data.decode(\"utf-8\", \"replace\")\n    for cand in (_dec.decode_chunked(txt), _dec.decode_chunk(txt), _atbash(txt), txt[::-1]):\n        v = _slug(cand)\n        if v:\n            return v\n    return None\n\n\ndef _past_deadline():\n    \"\"\"The timed runner's HCTF_SOLVE_DEADLINE (epoch) has passed: print the answers found so far instead.\"\"\"\n    try:\n        return time.time() > float(os.environ[\"HCTF_SOLVE_DEADLINE\"])\n    except (KeyError, ValueError):\n        return False\n\n\ndef _solve_pairs(job):\n    \"\"\"Answer one group of (answer_id, question) pairs -- a whole Mastery set, or the whole contract.\"\"\"\n    root, contract, pairs = job\n    out = {}\n    for aid, q in pairs:\n        data = artifact_bytes(root, contract, q.get(\"artifact\") or \"\")\n        try:\n            v = answer(aid, q, data, contract)\n        except Exception as e:  # noqa: BLE001 - one bad field must not sink the other answers\n            print(f\"{aid}: {e!r}\", file=sys.stderr)\n            v = None\n        if v is None and not _past_deadline():   # in-window: never let a fallback search eat the kill margin\n            try:\n                v = fallback(aid, q, data, contract)\n            except Exception as e:  # noqa: BLE001\n                print(f\"{aid}: fallback {e!r}\", file=sys.stderr)\n        if v is not None:\n            out[aid] = normalize(v, q)\n    return out\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--contract\", required=True)\n    ap.add_argument(\"--artifacts\", required=True)\n    a = ap.parse_args()\n    contract, pairs = load_contract(a.contract)\n    groups = group_by_set(pairs)\n    out = {}\n    if len(groups) >= 2 and os.environ.get(\"HCTF_SOLVER_PARALLEL\", \"1\") != \"0\":\n        # Mastery: every set runs inside ONE clock -- one forked process per set (the Homebase VM has 2 vCPUs; heavy\n        # per-set work such as unzipping 31 MB deliveries halves). Same results as the sequential loop.\n        import multiprocessing as mp\n        from concurrent.futures import ProcessPoolExecutor\n        try:\n            with ProcessPoolExecutor(max_workers=min(len(groups), os.cpu_count() or 2),\n                                     mp_context=mp.get_context(\"fork\")) as ex:\n                for part in ex.map(_solve_pairs, [(a.artifacts, contract, g) for g in groups.values()]):\n                    out.update(part)\n        except Exception as e:  # noqa: BLE001 - never lose a solve to the pool: fall back to sequential\n            print(f\"parallel sets failed ({e!r}); sequential\", file=sys.stderr)\n            out = _solve_pairs((a.artifacts, contract, pairs))\n    else:\n        out = _solve_pairs((a.artifacts, contract, pairs))\n    print(json.dumps(out))\n\n\nif __name__ == \"__main__\":\n    main()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016y5EydDdqYBguuMM2eNVsk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
