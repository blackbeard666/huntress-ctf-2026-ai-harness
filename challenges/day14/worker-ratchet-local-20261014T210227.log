e.escape(dashed[:-1])}([a-z0-9-]+)$\", tail)\n            hit = (fmt, fld[:-1] + mm.group(1).replace(\"-\", \"_\")) if mm else None\n            size = len(dashed) - 1\n        else:\n            hit = (fmt, fld) if re.search(rf\"(?:^|-){re.escape(fmt)}-{re.escape(dashed)}$\", tail) else None\n            size = len(dashed)\n        if hit and (best is None or size > best[0]):\n            best = (size, hit)\n    if best:\n        return _field(*best[1])\n    for rx, name in _IDENT:\n        mm = rx.search(tail)\n        if mm:\n            return _field(\"file\", name.format(*mm.groups()))\n    return None\n\n\ndef _load(fn):\n    mod, _, func = fn.partition(\":\")\n    return getattr(importlib.import_module(mod), func)\n\n\ndef answer(aid, q=None, data=None, member=None):\n    \"\"\"(value, tier) for one answer id from its artifact bytes (`member` = the name after '->'), else (None, None).\"\"\"\n    q = q or {}\n    f = parse_field(aid, q)\n    if f is None:\n        return None, None\n    ext, param = lookup(f.fmt, f.field)\n    if ext is None:\n        return None, None\n    if member is None:\n        member = str(q.get(\"artifact\") or \"\").partition(\"->\")[2].strip()\n    ctx = {\"aid\": aid, \"question\": q, \"fmt\": f.fmt, \"field\": f.field, \"param\": param, \"member\": member,\n           \"artifact\": q.get(\"artifact\") or \"\"}\n    raw = _load(ext.fn)(data, ctx)\n    if raw is None:\n        return None, None\n    return _spell.spell(f.fmt, f.field, raw, q), ext.tier\n\n\ndef known_fields():\n    \"\"\"Every (fmt, field) the active registry can answer, with its tier (docs / prompts).\"\"\"\n    return {k: e.tier for k, e in sorted(active().items())}\n\"\"\"MSI (Windows Installer) fields. COPIED from the GM-verified D13 solver\n(challenges/day13/metadata-product-placement/solver/solve.py): CFB streams -> !_StringPool/!_StringData -> !Property.\nmsi.product_code_guid = Property['ProductCode'] VERBATIM (uppercase, WITH braces; the bare form was REJEC