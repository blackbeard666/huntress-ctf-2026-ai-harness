tems():\n        f = meta.parse_field(aid, qs.get(aid) or {})\n        ext = meta.lookup(f.fmt, f.field)[0] if f else None\n        if aid not in got:\n            if ext is None:\n                gaps.append(f\"{rel}: {aid} ({f and f'{f.fmt}.{f.field}'})\")\n            else:\n                fails.append(f\"{rel}: {aid} registered ({f.fmt}.{f.field}) but no answer\")\n            continue\n        n_vals += 1\n        if got[aid] != want:\n            fails.append(f\"{rel}: {aid} = {got[aid]!r}, GM expected {want!r}\")\nassert not fails, \"lane solver mismatches:\\n  \" + \"\\n  \".join(fails[:20])\nassert not slow, f\"lane solver over 1 s: {slow}\"\nassert not (STRICT and gaps), f\"coverage gaps (HCTF_META_STRICT=1): {gaps[:10]}\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"cb37d77e-da1b-4d6b-8823-5e5c68336b91","uuid":"0f49f6fb-fdc1-4f2b-ad60-c66e11a8a8f0","timestamp":"2026-10-31T04:39:14.538Z","tool_use_result":{"stdout":" 12:39:14 up 13:52,  1 user,  load average: 4.36, 5.00, 6.43\n# prebuild gates run beside 4 other lane workers: 1.01-1.48 s cases failed on contention, not on the solver)\nSLOW_S = 1.0 * float(os.environ.get(\"HCTF_TEST_TIME_SLACK\", \"1\"))\n# The ratchet gate runs suites in parallel (and other suites/solvers may share the box): scale the budget with the\n# 1-min load per core, so a loaded host can't fail -- and REVERT -- a good lib merge on timing alone (D16 post-mortem).\nSLOW_BASE = SLOW_S\n\n\ndef _load_scale():\n    return max(1.0, os.getloadavg()[0] / max(1, (os.cpu_count() or 2) / 2))\n\n\nSLOW_S = SLOW_BASE * _load_scale()\n# 1) every metadata case through the lane solver\nwith ThreadPoolExecutor(max_workers=4) as ex:\n    res = list(ex.map(lambda c: (c, run_case(LANE, c)), CASES))\nfor i, (case, r) in enumerate(res):        # a case over budget under the 4-way load is re-timed alone\n    for _ in range(3):                      # best of 3: one re-time under a parallel sweep is still noise (D23: a\n        if res[i][1]