jdump, aapt + apktool/jadx (`source bin/env.sh`); .venv: olevba/oleid, olefile,\n  pefile, pyelftools, LnkParse3, dnfile, mutagen, androguard, python-evtx, regipy, dissect.util (lzxpress_huffman,\n  lznt1, lz4, lzo) -- all worker-only, not in the prebuild gate; msitools under tools/msitools; ffmpeg 7.0.2 at\n  `tools/imageio_ffmpeg_pkg/imageio_ffmpeg/binaries/ffmpeg-linux-x86_64-v7.0.2` (not on PATH). NOT: ffprobe, sox.\n'''\nt=t[:a]+new\nopen(p,'w').write(t)\nEOF\nwc -l reference/techniques/metadata-forensics.md; sed -n 40,110p reference/techniques/metadata-forensics.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4850,"cache_read_input_tokens":117874,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4850},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c997e921-7591-43d7-ab62-2cec08c53d99","uuid":"84b96ab2-30ac-4770-a278-cd3db3258000","timestamp":"2026-10-26T13:09:03.045Z","request_id":"req_011CgQuFWDncuGBBvDx8ZRu8","wire_tool_inputs":{"toolu_01URYn9PBJtDyG77uc9eSury":{"command":"cd /home/testpwn/huntress-2026; python3 - <<'EOF'\np='reference/techniques/metadata-forensics.md'\nt=open(p).read()\na=t.index(\"## Delivery layouts seen\"); \nnew='''## Delivery layouts seen (resolve these before parsing)\n- Single / TT: one zip; members named in `artifact` after `->` (filename questions: artifact = the zip only). Mastery:\n  ONE download holding `-01.zip`..`-NN.zip` (D7 three levels deep); refs `<set zip> -> <member>`, names reused per set\n  -> resolve by (set zip, member). D9: download `<id>-mastery.zip` vs refs `...-evidence-0N.zip` -> resolve by sha256\n  (`lib.common.container_by_sha`). D6: two same-named downloads -> `delivery N: <zip>` refs.\n\n## Pitfalls that cost tim