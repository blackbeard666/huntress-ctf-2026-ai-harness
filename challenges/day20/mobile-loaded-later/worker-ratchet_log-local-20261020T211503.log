     with ProcessPoolExecutor(max_workers=min(len(groups), os.cpu_count() or 2),\n                                     mp_context=mp.get_context(\"fork\")) as ex:\n                for part in ex.map(_solve_pairs, [(a.artifacts, contract, g) for g in groups.values()]):\n                    out.update(part)\n        except Exception as e:  # noqa: BLE001 - never lose a solve to the pool: fall back to sequential\n            print(f\"parallel sets failed ({e!r}); sequential\", file=sys.stderr)\n            out = _solve_pairs((a.artifacts, contract, pairs))\n    else:\n        out = _solve_pairs((a.artifacts, contract, pairs))\n    print(json.dumps(out))\n\n\nif __name__ == \"__main__\":\n    main()\nchallenges/day20/mobile-loaded-later/solver/cases/auto-mastery-427b4f23/:\nartifacts\ncontract.json\nexpected.json\n\nchallenges/day20/mobile-loaded-later/solver/cases/auto-mastery-459447cc/:\nartifacts\ncontract.json\nexpected.json\n\nchallenges/day20/mobile-loaded-later/mastery:\nconfirmed.json\ncontract.json\nlast_timed.json\nlog.jsonl\nsubmissions.jsonl\n\nchallenges/day20/mobile-loaded-later/time_trial:\nconfirmed.json\ncontract.json\nlast_timed.json\nlog.jsonl\nsubmissions.jsonl\n{\n  \"result\": \"correct\",\n  \"full_result\": \"correct\",\n  \"attempt_id\": \"b932824a-998c-43c9-86d0-545b0f83686b\",\n  \"window\": null,\n  \"elapsed\": 4.39,\n  \"in_window\": 3.06,\n  \"phases\": {\n    \"start\": 1.33,\n    \"download\": 0.0,\n    \"solve\": 0.99,\n    \"submit\": 2.07\n  },\n  \"routed\": \"local\",\n  \"novel_labels\": {},\n  \"deadline\": null,\n  \"verified\": {\n    \"answer\": \"ANS-43ED6F08E3A1A6E2\"\n  },\n  \"attempts_remaining\": 32,\n  \"run_for_time\": false,\n  \"hall_of_fame_eligible\": false,\n  \"ranked_attempts_remaining\": 32,\n  \"variant_fresh\": true,\n  \"no_clock\": true,\n  \"gm_remaining\": 1\n}{\n  \"result\": \"correct\",\n  \"full_result\": \"correct\",\n  \"attempt_id\": \"c87023f1-8aae-424d-b60c-53a5548ca5f3\",\n  \"window\": null,\n  