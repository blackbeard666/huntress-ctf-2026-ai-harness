dded WMI MOF hosts (polyglot-wmi_mof-*.mof,\n# plan in a `// HUNTRESS_ANALYSIS_V1:FRAG-..` comment, language=wmi_mof, host_profile \"standalone\"): launcher+staged_chain =\n# T1059 again; MOF benign_utility had steps decode_embedded>write_file>dispatch_process (plan wins again).\n# Day 11 \"By Any Other Name\" (single + TT f99ea9ec + Mastery 2d722b36, 0 wrong) added TypeScript (polyglot-typescript-*.ts,\n# `// HUNTRESS_ANALYSIS_V1:{FRAG,HEX,B64,HB64}-` comment, host_profile \"standalone\"): launcher+staged_chain = T1059,\n# downloader T1105, benign none -- same table; adapters local_parser/http_client/process_builder/operation_graph.\n# Day 12 \"AutoIt Takes Two\" (single + TT d629142e + Mastery 635241de, 0 wrong) added AutoIt (polyglot-autoit-*.au3, plan in a\n# `; HUNTRESS_ANALYSIS_V1:HB64-` comment + `Global Const $descriptor_<id> = \"<hex>\"`): launcher+staged_chain = T1059,\n# downloader T1105, benign none -- same table again; obfuscation labels plain_hex/base64/hex_base64 read from the plan.\nV3_ROLE_ATTACK_CONFIRMED = {\n    \"benign_utility\": \"none\", \"stager\": \"T1105\", \"downloader\": \"T1105\", \"dropper\": \"T1140\", \"uploader\": \"T1041\",\n    \"launcher\": \"T1059\", \"staged_chain\": \"T1059\", \"persistence_descriptor\": \"T1053\",\n}\n# Codec_ key field spellings seen in the generator's bytes (Bash, Day 6): contiguous hex for one-byte keys ('1b'), and\n# comma-separated hex bytes for multi-byte repeating_key_xor keys ('55,51,74,dd,3a'; Mastery 3bc5446b + GM-correct\n# 368acf67). Parsing the comma form as contiguous hex yields key [0] and silently breaks the decode. Use\n# lib.scripts.codec_key(), which accepts both (and ':'/space/';'/'-' separators, not yet seen in the bytes).\nCODEC_KEY_FORMS = {\"hex_contiguous\": \"1b\", \"hex_comma\": \"55,51,74,dd,3a\"}\nCODEC_KEY_COMMA_TRANSFORMS = (\"repeating_key_xor\",)\n","structuredPatch":[{"oldStart":81,"oldLines":6,"newStart":81,"newLines":14,"lines":["     \".NET Framework\", \".NET Core\", \"framework\", \"core\", \"none\","," ]"," ","+# Day 15 \"Stripped\" (binary-reverse-engineering), confirmed 2026-10-15 (single, TT, Mastery 5 sets; 0 wrong): an id","+# `dNN_analysis_<qualifier>_<field>` whose first token after `analysis_` is NOT a field word names ONE member of the","+# group by its file-name tag (`d15--variant-000-stripped.elf` -> analysis_stripped_*; `..-symbolized.elf` ->","+# analysis_symbolized_*): answer <field> (format/architecture/machine/config_campaign/config_domain) for THAT member","+# only. Renamed members: stripped = the ELF without `.symtab`, symbolized/unstripped = with it. Values as usual","+# (elf / x86-64 / decimal e_machine \"62\"; the stripped twin still carries the same HCFG config).","+BINARY_MEMBER_QUALIFIERS = {\"stripped\": False, \"symbolized\": True, \"unstripped\": True}   # -> has .symtab","+"," # Day 4 \"Picture This\" (metadata-forensics), confirmed 2026-10-04: jpeg.sof_dimensions_pixels is the SOFn frame"," # header size as '<width>x<height>' (X then Y, lowercase 'x', no spaces), e.g. \"257x146\" — not EXIF/filename dims."," JPEG_DIMENSIONS_FMT = \"{width}x{height}\""]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01Vria4ZQruNRgASfyo2qFEP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
