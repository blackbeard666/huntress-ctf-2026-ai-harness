n        print('  zip',k,'contains',n,'== member' if hh in byh else 'no-match', byh.get(hh,[])[:3])\n  # pngs chunk lists\n  pngs=[(k,chunks(v)) for k,v in m.items() if v[:4]==b'\\x89PNG']\n  print('  png chunks', set(tuple(c) for _,c in pngs))\n  # near dup: same length differs in <=2 bytes\n  ks=list(m)\n  for a in range(len(ks)):\n    for b2 in range(a+1,len(ks)):\n      x,y=m[ks[a]],m[ks[b2]]\n      if x!=y and len(x)==len(y) and sum(p!=q for p,q in zip(x,y))<=2: print('  near-dup',ks[a],ks[b2])\nEOF","description":"Analyze unasked relation siblings in clusters"}}}
