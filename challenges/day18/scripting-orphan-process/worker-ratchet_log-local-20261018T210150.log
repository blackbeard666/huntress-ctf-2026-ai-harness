-> [str], else None.\"\"\"\n    if not re.fullmatch(r\"\\s*\" + _PS_S + r\"(?:\\s*,\\s*\" + _PS_S + r\")*\\s*\", body):\n        return None\n    return [_ps_u(a) for a in re.findall(_PS_S, body)]\n\n\ndef _ps_nums(body):\n    toks = [t for t in re.split(r\"[\\s,]+\", body.strip()) if t]\n    try:\n        return [int(t, 0) for t in toks] if toks else None\n    except ValueError:\n        return None\n_max_day known _base_transform b64 int_array hex_bytes key_bytes looks_like_plan plan_kv plan_key_for _plan_dict plan_answer _rep_candidates _xor _rolling _transform_candidates _rc4 _inflate _layer_readings _spec decode _generic_readings _fallback _fallback_layers material_text _tpl_unescape _tpl_stmts _tpl_parse _tpl_ops _tpl_apply _tpl_numbers _tpl_decode wsh_decode_block wsh_decode _bh_lines _bh_expand _bh_shell_calls _bh_echo_args _bh_payloads _build_host_codecs find_codecs _find_codecs_text _descriptor_literals _yaml_indent _yaml_children _yaml_node _yaml_sibling_value _read_literal _descriptor_literals_ext _ahk_value _ahk_literals _peel_ext _marker_continued _utf16 _leaf_text normalize _peel_children peel_plan _reg_bytes_text _inf_split _reg_inf_host _reg_inf_codecs _xml_flat _xsl_fold _xpath_literal _xslt_codecs _psv3_str _psv3_dq _psv3_ws _psv3_expr _psv3_items _psv3_group _ps_descriptor_literals _ps_v3_codecs _psv3_lossy v3_plan is_v3 _ps_q _ps_u _ps_list _ps_nums _ps_tokens _ps_format _ps_fold_once _ps_simplify _ps_inflate _ps_payloads _ps_codecs _bat_run _bat_codecs _ovba_decompress _vba_sources _vba_dir_offsets _carrier_blobs _carrier_texts _carrier_codecs _encode_transform _format_like encode _ch_unescape _ch_uu _marshal_plan _chain_codecs _eq_field _eq_value _eq_dict plan_canonical equivalence equivalence_answer label_regime batch_join_pool label_expansion refang _rc_idna _rc_split canon_host canon_url _rc_field _rc_dict declared_fetches _fs_unescape _fs_split _fs_ints _fs_lookup _fs_interp _fs_eval _fs_flat _fs_env _fs_args _fs_url_of _fs_cmd fetch_sites