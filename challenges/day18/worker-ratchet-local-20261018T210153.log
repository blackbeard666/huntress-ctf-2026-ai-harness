lds(path):\n    \"\"\"The literal FIELDS dict of a prebuilt module, read with ast (no import), or {}.\"\"\"\n    try:\n        tree = ast.parse(Path(path).read_text())\n    except (OSError, SyntaxError, ValueError):\n        return {}\n    for node in tree.body:\n        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == \"FIELDS\" for t in node.targets):\n            try:\n                val = ast.literal_eval(node.value)\n            except ValueError:\n                return {}\n            return val if isinstance(val, dict) else {}\n{\n  \"84547659-c59b-4026-8c9b-1fdd9667728a\": {\n    \"set1.evidence-note-copy-filename\": \"evidence-note-copy.txt\",\n    \"set1.roster-size-bytes\": \"29\",\n    \"set1.evidence-note-md5\": \"219f643d43c483eefe068c70629c5d00\",\n    \"set1.roster-sha1\": \"4d4ff9f392a102e9d3d5676a10a1152fc426ad10\",\n    \"set1.evidence-note-copy-sha256\": \"ff90816f88c0e1454b852a58363d813270ea59ab12237deb01b5e4dc55cbafec\",\n    \"set1.evidence-note-magic-prefix-hex-16\": \"43617365203632453232304234443532\",\n    \"set1.evidence-note-text-utf8-bom-present\": \"false\",\n    \"set1.d04-jpeg-001-jpeg-sof-dimensions-pixels\": \"926x1000\",\n    \"set1.d05-png-001-png-ihdr-dimensions-pixels\": \"901x958\",\n    \"set1.d06-pdf-001-pdf-header-version\": \"1.4\",\n    \"set1.d07-zip-001-zip-eocd-total-entries\": \"2\",\n    \"set1.d07-zip-001-zip-central-directory-mauto-mastery-84547659\nauto-time_trial-175df70b\nsingle_solve","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0129jCLarVuwTwYMdhBKyEd3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
