IDNA punycode<->unicode, drop default port/fragment/trailing '/', percent-decode unreserved, keep path case. Return the ORIGINAL spelling for answers (exact_text is verbatim), use canon only for matching.\"},\n {\"id\":\"ahk-compiled-exe-extract\",\"concept\":\"compiled AutoHotkey/AutoIt carriers + AHK v1 legacy syntax\",\"priority\":2,\"action\":\"prebuild\",\"detail\":\"D17 AHK and D12 AutoIt shipped source only; the D6 Python precedent (cx_Freeze on a TT) says a compiled carrier can appear on a variant. AHK Ahk2Exe stores the script as PE RCDATA `>AUTOHOTKEY SCRIPT<` / `>AHK WITH ICON<` (plain text, v1.1.34+ optionally compressed) -> pefile (.venv) resource walk; AutoIt a3x -> existing autoit-ripper / .venv/bin/a3x. Also accept AHK v1 descriptor forms: `descriptor_x = text` (unquoted legacy), `descriptor_x := \\\"..\\\"`, continuation sections `(\\\\n..\\\\n)` and `.`-concat. Route the recovered text through the V3_MARK path.\"},\n]\nkeep=[old[i] for i in ['vba-module-route','python-exec-onion-static','dockerfile-makefile-route']]\nkeep[0]['priority']=2; keep[1]['priority']=2; keep[2]['priority']=3\nkeep[0]['detail']+=\" (1st prebuild attempt failed D16 night -- retry.)\"\nkeep[1]['detail']+=\" (1st prebuild attempt failed -- retry.)\"\nkeep[2]['detail']+=\" (1st prebuild attempt failed -- retry.)\"\ntools=[old[i] for i in ['php-cli','lua-unluac','xsltproc-cabextract-yq','tcl-r-interpreters','applescript-scpt','js-deob-extras','ps-deob-modules','xlm-standalone','dotnet-script']]\nnotes=[old[i] for i in ['leaf-ext-list','new-synthetic-label-family','family-name-underscore']]\nnotes[0]['detail']=notes[0]['detail'].replace(\".pl .rb (and\",\".pl .rb .ahk (and\")\nnotes[2]['detail']+=\" D17 added `polyglot-auto_hotkey` (campaign AUTO_HOTKEY-, url host auto_hotkey-..).\"\ngaps=new[:4]+[new[4],keep[0],keep[1],new[5]]+[g for g in tools if g['priority']==2]+[keep[2]]+[g for g in tools if g['priority']!=2]+notes\nassert len({g['id'] for g in gaps})==len(gaps)\nbody=json.dumps(gaps,ensure_ascii=False,indent=0).replace('[\\n{','[\\n  {').replace('},\\n{','},\\n  {').replace('}\\n]','}\\n]')\n# one gap per line\nbody=\"[\\n\"+\",\\n\".join(\"  \"+json.dumps(g,ensure_ascii=False) for g in gaps)+\"\\n]\\n\"\npre=\"Built by the nightly prebuild (dropped from the queue, still usable from lib/): \"+\", \".join(built)+\". Resolved: mastery-runner-budget (D17 5-set Mastery 12.7 s).\\n\\n\"\ns=s[:s.index(\"## Readiness gaps\\n\")]+\"## Readiness gaps\\n\"+pre+\"```json\\n\"+body+s[b:]\nopen(p,'w').write(s)\na=s.index(\"```json\\n\")+8; b=s.index(\"```\",a); g=json.loads(s[a:b])\nprint(len(g), sum(1 for x in g if x['action']=='prebuild'), [x['id'] for x in g])\nE"}}}
