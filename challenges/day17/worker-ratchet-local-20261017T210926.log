of the task (organizer: \\\"new unseen effects\\\"), so fix the family, not\\nthe sample:\\n1. Open the newest `solver/cases/variant-*` / `auto-*` / `mutation-*` case: `contract.json` (sets, questions, artifact\\n   names) and its artifacts. Compare with a passing case. Usual differences:\\n   - new file names, an archive wrapper, more nesting, a delivery named `delivery N: <name>` per Mastery set\\n   - more or fewer encoding layers, a different codec / key / alphabet / radix, another container (ELF<->PE)\\n   - extra Mastery sets, or an ESCALATED field set carrying earlier days' questions (`dNN-...` ids): the verdict names\\n     the earlier day's solver of this lane -- adapt (import or port) its parsing; answers still come from today's bytes\\n   - `mutation-*`: same answers, answer-invariant change (renamed delivery, reordered/subset/extra questions, two sets)\\n2. Patch `solver/solve.py` with the smallest GENERAL change (no answer literals, no special case for this variant);\\n   every field fails independently, unknown questions are skipped, a cheap fallback runs only on a miss.\\n3. `timeout 20 hctf solver-test <base id>` -- every case passes -- and `hctf solver-run <mode id>` outputs every\\n   answer_id. Then stop.\\n\"}]},\"parent_tool_use_id\":null,\"session_id\":\"bc1828f9-e7fd-4913-977a-0de0ab7363e8\",\"uuid\":\"973d7fe4-9548-4ae0-b597-14b2fba70764\",\"timestamp\":\"2026-10-17T13:02:20.118Z\",\"isSynthetic\":true}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011Cg7rUxP6XpAQeC3AjMVMQ\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01WNQ7zsk99fjYFczvGBuL7D\",\"name\":\"Bash\",\"input\":{\"command\":\"cd /home/testpwn/huntress-2026/challenges/day17/warmups-bacon-bits; cat solver/solve.py; ls solver/cases/*; cat solver/NOTES.md 2>/dev/null | head -50\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2193,\"cache_read_input_tokens\":24607,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2193},\"output_tokens\":16,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"bc1828f9-e7fd-4913-977a-0de0ab7363e8\",\"uuid\":\"0db8bb09-8ebb-4d95-9c2d-2c8ce140d265\",\"timestamp\":\"2026-10-17T13:02:23.425Z\",\"request_id\":\"req_011Cg7rUx317NsscbTCnQM8r\",\"wire_tool_inputs\":{\"toolu_01WNQ7zsk99fjYFczvGBuL7D\":{\"command\":\"cd /home/testpwn/huntress-2026/challenges/day17/warmups-bacon-bits; cat solver/solve.py; ls solver/cases/*; cat solver/NOTES.md 2>/dev/null | head -50\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01WNQ7zsk99fjYFczvGBuL7D\",\"type\":\"tool_result\",\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Solver for this challenge -- harness skeleton. Fill in `answer()`; keep the I/O contract unchanged.\\n\\n    solve.py --contract <contract.json> --artifacts <dir>   ->  prints {answer_id: value} as JSON on the last line\\n\\nRuns on the Homebase VM inside a ~6-7 s window for EVERY Mastery set: stdlib + lib.* + pyzipper/pyelftools/pefile/\\ncapstone/pycryptodome/androguard only, no subprocess to 7z/jadx/etc., all sets well under 1 s. Mastery questions name\\ntheir files like 'delivery 2: sample_02.apk' or 'evidence.zip -> member': `artifact_bytes()` resolves both (by sha256\\npairing first, so same-named per-set deliveries never get mixed up).\\\"\\\"\\\"\\nimport re\\nimport argparse\\nimport json\\nimport os\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[4]\\nsys.path.insert(0, str(ROOT))\\nfrom lib.common import (container_by_sha, delivery_missing, find_artifact, group_by_set, load_contract,  # noqa: E402\\n                        normalize)\\n\\n_cache = {}\\n\\n\\ndef artifact_bytes(root, contract, artifact):\\n    \\\"\\\"\\\"Bytes for a question's `artifact` string (cached per artifact).\\\"\\\"\\\"\\n    if artifact in _cache:\\n        return _cache[artifact]\\n    container, _, member = (x.strip() for x in artifact.partition(\\\"->\\\"))\\n    data = None\\n    p = container_by_sha(root, contract, container)\\n    if p is not None and not member:\\n        data = p.read_bytes()\\n    elif not delivery_missing(root, contract, container):\\n        for cand in (artifact, container.split(\\\": \\\", 1)[-1] + (f\\\" -> {member}\\\" if member else \\\"\\\")):\\n            try:\\n                data = find_artifact(root, cand)\\n                break\\n            except FileNotFoundError:\\n                continue\\n    _cache[artifact] = data\\n    return data\\n\\n\\ndef answer(answer_id, question, data, contract):\\n    \\\"\\\"\\\"Return the value for one answer_id from its artifact bytes (None = cannot answer). Derive everything from\\n    `data`; never hard-code a variant's values.\\\"\\\"\\\"\\n    text = data.decode(\\\"utf-8\\\", \\\"replace\\\") if isinstance(data, bytes) else data\\n    if re.match(r\\\"\\\\s*\\\\d{2}\\\\t\\\", text):  # Mastery: numbered lines, line k in day k's encoding (D15 = ROT47)\\n        cands = [decode.decode_chunked(text)]\\n        try:\\n            cands += decode.decode_candidates(text, 5)\\n        except Exception:  # noqa: BLE001\\n            pass\\n    else:\\n        cands = [_baconhex(text), _morsehex(text), _rot47(text.strip())]\\n        try:\\n            cands.append(decode.decode_chunk(text.strip()))\\n        except Exception:  # noqa: BLE001\\n            pass\\n    for c in cands:\\n        m = _slug(c)\\n        if m:\\n            return m\\n    return None\\n\\n\\ndef _morsehex(s):\\n    \\\"\\\"\\\"D16: Morse code whose symbols are hex digits of the UTF-8 text (or plain Morse text).\\\"\\\"\\\"\\n    t = s.strip().strip('\\\"')\\n    if not t or not re.fullmatch(r\\\"[.\\\\-/ \\\\t\\\\r\\\\n]+\\\", t) or not re.search(r\\\"[.\\\\-]\\\", t):\\n        return None\\n    try:\\n        from lib.ciphers import morse_decode\\n        m = morse_decode(t)\\n    except Exception:  # noqa: BLE001\\n        return None\\n    h = re.sub(r\\\"\\\\s\\\", \\\"\\\", m or \\\"\\\")\\n    if re.fullmatch(r\\\"(?:[0-9A-Fa-f]{2})+\\\", h):\\n        try:\\n            return bytes.fromhex(h).decode(\\\"utf-8\\\")\\n        except Exception:  # noqa: BLE001\\n            pass\\n    return m.lower() if m else None\\n\\n\\ndef _baconhex(s):\\n    \\\"\\\"\\\"D17: Baconian 5-symbol a/b groups; each group's index (a=0, b=1) is one hex nibble of the UTF-8 text\\n    (\\\"Sixteen guests\\\"). Groups >= 16 -> plain Bacon letters (26-letter, else 24-letter I=J/U=V alphabet).\\\"\\\"\\\"\\n    t = s.strip().strip('\\\"')\\n    if not t or not re.fullmatch(r\\\"[abAB\\\\s]+\\\", t):\\n        return None\\n    bits = re.sub(r\\\"\\\\s\\\", \\\"\\\", t).lower().replace(\\\"a\\\", \\\"0\\\").replace(\\\"b\\\", \\\"1\\\")\\n    if not bits or len(bits) % 5:\\n        return None\\n    vals = [int(bits[i:i + 5], 2) for i in range(0, len(bits), 5)]\\n    if max(vals) < 16 and len(vals) % 2 == 0:\\n        try:\\n            return bytes.fromhex(\\\"\\\".join(\\\"%x\\\" % v for v in vals)).decode(\\\"utf-8\\\")\\n        except Exception:  # noqa: BLE001\\n            pass\\n    a26 = \\\"abcdefghijklmnopqrstuvwxyz\\\"\\n    if max(vals) < 26:\\n        return \\\"\\\".join(a26[v] for v in vals)\\n    return None\\n\\n\\ndef _rot47(s):\\n    return \\\"\\\".join(chr(33 + (ord(ch) - 33 + 47) % 94) if 33 <= ord(ch) <= 126 else ch for ch in s)\\n\\n\\ndef _slug(c):\\n    if isinstance(c, (list, tuple)):\\n        c = c[0] if c and isinstance(c[0], str) else (c[1] if len(c) > 1 and isinstance(c[1], str) else \\\"\\\")\\n    if not isinstance(c, str):\\n        return None\\n    lines = [l for l in c.splitlines() if l.strip()]\\n    if not lines:\\n        return None\\n    m = re.search(r\\\"([a-z]+(?:-[a-z]+){2}-\\\\d{2})\\\\s*$\\\", lines[-1])\\n    return m.group(1) if m else None\\n\\n\\ntry:\\n    from lib import decode\\n    decode.register_free(\\\"rot47\\\", 15, lambda p: [_rot47(p)])\\n    decode.register_free(\\\"morsehex\\\", 16, lambda p: [x for x in [_morsehex(p)] if x])\\n    decode.register_free(\\\"baconhex\\\", 17, lambda p: [x for x in [_baconhex(p)] if x])\\nexcept Exception:  # noqa: BLE001\\n    decode = None\\n\\n\\ndef fallback(answer_id, question, data, contract):\\n    \\\"\\\"\\\"Called ONLY when answer() found nothing (None or an exception): a cheap generic second try for a variant shape\\n    the direct parse doesn't know (Time Trial / Mastery mutate the task) -- e.g. the lane lib's name-agnostic decoder\\n    over `data`, then a match against question[\\\"answer_format\\\"]. None = give up on this field only.\\\"\\\"\\\"\\n    return None\\n\\n\\ndef _past_deadline():\\n    \\\"\\\"\\\"The timed runner's HCTF_SOLVE_DEADLINE (epoch) has passed: print the answers found so far instead.\\\"\\\"\\\"\\n    try:\\n        return time.time() > float(os.environ[\\\"HCTF_SOLVE_DEADLINE\\\"])\\n    except (KeyError, ValueError):\\n        return False\\n\\n\\ndef _solve_pairs(job):\\n    \\\"\\\"\\\"Answer one group of (answer_id, question) pairs -- a whole Mastery set, or the whole contract.\\\"\\\"\\\"\\n    root, contract, pairs = job\\n    out = {}\\n    for aid, q in pairs:\\n        data = artifact_bytes(root, contract, q.get(\\\"artifact\\\") or \\\"\\\")\\n        try:\\n            v = answer(aid, q, data, contract)\\n        except Exception as e:  # noqa: BLE001 - one bad field must not sink the other answers\\n            print(f\\\"{aid}: {e!r}\\\", file=sys.stderr)\\n            v = None\\n        if v is None and not _past_deadline():   # in-window: never let a fallback search eat the kill margin\\n            try:\\n                v = fallback(aid, q, data, contract)\\n            except Exception as e:  # noqa: BLE001\\n                print(f\\\"{aid}: fallback {e!r}\\\", file=sys.stderr)\\n        if v is not None:\\n            out[aid] = normalize(v, q)\\n    return out\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--contract\\\", required=True)\\n    ap.add_argument(\\\"--artifacts\\\", required=True)\\n    a = ap.parse_args()\\n    contract, pairs = load_contract(a.contract)\\n    groups = group_by_set(pairs)\\n    out = {}\\n    if len(groups) >= 2 and os.environ.get(\\\"HCTF_SOLVER_PARALLEL\\\", \\\"1\\\") != \\\"0\\\":\\n        # Mastery: every set runs inside ONE clock -- one forked process per set (the Homebase VM has 2 vCPUs; heavy\\n        # per-set work such as unzipping 31 MB deliveries halves). Same results as the sequential loop.\\n        import multiprocessing as mp\\n        from concurrent.futures import ProcessPoolExecutor\\n        try:\\n            with ProcessPoolExecutor(max_workers=min(len(groups), os.cpu_count() or 2),\\n                                     mp_context=mp.get_context(\\\"fork\\\")) as ex:\\n                for part in ex.map(_solve_pairs, [(a.artifacts, contract, g) for g in groups.values()]):\\n                    out.update(part)\\n        except Exception as e:  # noqa: BLE001 - never lose a solve to the pool: fall back to sequential\\n            print(f\\\"parallel sets failed ({e!r}); sequential\\\", file=sys.stderr)\\n            out = _solve_pairs((a.artifacts, contract, pairs))\\n    else:\\n        out = _solve_pairs((a.artifacts, contract, pairs))\\n    print(json.dumps(out))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\nsolver/cases/auto-mastery-81f42697:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-mastery-bb73672b:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-time_trial-8790e0e1:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-time_trial-8c6bc748:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-time_trial-ddaa56a0:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/single_solve:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/variant-mastery-f9ac3fc4:\\nartifacts\\ncontract.json\\nexpected.json\\ngm_feedback.json\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"bc1828f9-e7fd-4913-977a-0de0ab7363e8\",\"uuid\":\"270a5c53-24f8-4f10-9dc1-a0eb79793f1f\",\"timestamp\":\"2026-10-17T13:02:23.563Z\",\"tool_use_result\":{\"stdout\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Solver for this challenge -- harness skeleton. Fill in `answer()`; keep the I/O contract unchanged.\\n\\n    solve.py --contract <contract.json> --artifacts <dir>   ->  prints {answer_id: value} as JSON on the last line\\n\\nRuns on the Homebase VM inside a ~6-7 s window for EVERY Mastery set: stdlib + lib.* + pyzipper/pyelftools/pefile/\\ncapstone/pycryptodome/androguard only, no subprocess to 7z/jadx/etc., all sets well under 1 s. Mastery questions name\\ntheir files like 'delivery 2: sample_02.apk' or 'evidence.zip -> member': `artifact_bytes()` resolves both (by sha256\\npairing first, so same-named per-set deliveries never get mixed up).\\\"\\\"\\\"\\nimport re\\nimport argparse\\nimport json\\nimport os\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[4]\\nsys.path.insert(0, str(ROOT))\\nfrom lib.common import (container_by_sha, delivery_missing, find_artifact, group_by_set, load_contract,  # noqa: E402\\n                        normalize)\\n\\n_cache = {}\\n\\n\\ndef artifact_bytes(root, contract, artifact):\\n    \\\"\\\"\\\"Bytes for a question's `artifact` string (cached per artifact).\\\"\\\"\\\"\\n    if artifact in _cache:\\n        return _cache[artifact]\\n    container, _, member = (x.strip() for x in artifact.partition(\\\"->\\\"))\\n    data = None\\n    p = container_by_sha(root, contract, container)\\n    if p is not None and not member:\\n        data = p.read_bytes()\\n    elif not delivery_missing(root, contract, container):\\n        for cand in (artifact, container.split(\\\": \\\", 1)[-1] + (f\\\" -> {member}\\\" if member else \\\"\\\")):\\n            try:\\n                data = find_artifact(root, cand)\\n                break\\n            except FileNotFoundError:\\n                continue\\n    _cache[artifact] = data\\n    return data\\n\\n\\ndef answer(answer_id, question, data, contract):\\n    \\\"\\\"\\\"Return the value for one answer_id from its artifact bytes (None = cannot answer). Derive everything from\\n    `data`; never hard-code a variant's values.\\\"\\\"\\\"\\n    text = data.decode(\\\"utf-8\\\", \\\"replace\\\") if isinstance(data, bytes) else data\\n    if re.match(r\\\"\\\\s*\\\\d{2}\\\\t\\\", text):  # Mastery: numbered lines, line k in day k's encoding (D15 = ROT47)\\n        cands = [decode.decode_chunked(text)]\\n        try:\\n            cands += decode.decode_candidates(text, 5)\\n        except Exception:  # noqa: BLE001\\n            pass\\n    else:\\n        cands = [_baconhex(text), _morsehex(text), _rot47(text.strip())]\\n        try:\\n            cands.append(decode.decode_chunk(text.strip()))\\n        except Exception:  # noqa: BLE001\\n            pass\\n    for c in cands:\\n        m = _slug(c)\\n        if m:\\n            return m\\n    return None\\n\\n\\ndef _morsehex(s):\\n    \\\"\\\"\\\"D16: Morse code whose symbols are hex digits of the UTF-8 text (or plain Morse text).\\\"\\\"\\\"\\n    t = s.strip().strip('\\\"')\\n    if not t or not re.fullmatch(r\\\"[.\\\\-/ \\\\t\\\\r\\\\n]+\\\", t) or not re.search(r\\\"[.\\\\-]\\\", t):\\n        return None\\n    try:\\n        from lib.ciphers import morse_decode\\n        m = morse_decode(t)\\n    except Exception:  # noqa: BLE001\\n        return None\\n    h = re.sub(r\\\"\\\\s\\\", \\\"\\\", m or \\\"\\\")\\n    if re.fullmatch(r\\\"(?:[0-9A-Fa-f]{2})+\\\", h):\\n        try:\\n            return bytes.fromhex(h).decode(\\\"utf-8\\\")\\n        except Exception:  # noqa: BLE001\\n            pass\\n    return m.lower() if m else None\\n\\n\\ndef _baconhex(s):\\n    \\\"\\\"\\\"D17: Baconian 5-symbol a/b groups; each group's index (a=0, b=1) is one hex nibble of the UTF-8 text\\n    (\\\"Sixteen guests\\\"). Groups >= 16 -> plain Bacon letters (26-letter, else 24-letter I=J/U=V alphabet).\\\"\\\"\\\"\\n    t = s.strip().strip('\\\"')\\n    if not t or not re.fullmatch(r\\\"[abAB\\\\s]+\\\", t):\\n        return None\\n    bits = re.sub(r\\\"\\\\s\\\", \\\"\\\", t).lower().replace(\\\"a\\\", \\\"0\\\").replace(\\\"b\\\", \\\"1\\\")\\n    if not bits or len(bits) % 5:\\n        return None\\n    vals = [int(bits[i:i + 5], 2) for i in range(0, len(bits), 5)]\\n    if max(vals) < 16 and len(vals) % 2 == 0:\\n        try:\\n            return bytes.fromhex(\\\"\\\".join(\\\"%x\\\" % v for v in vals)).decode(\\\"utf-8\\\")\\n        except Exception:  # noqa: BLE001\\n            pass\\n    a26 = \\\"abcdefghijklmnopqrstuvwxyz\\\"\\n    if max(vals) < 26:\\n        return \\\"\\\".join(a26[v] for v in vals)\\n    return None\\n\\n\\ndef _rot47(s):\\n    return \\\"\\\".join(chr(33 + (ord(ch) - 33 + 47) % 94) if 33 <= ord(ch) <= 126 else ch for ch in s)\\n\\n\\ndef _slug(c):\\n    if isinstance(c, (list, tuple)):\\n        c = c[0] if c and isinstance(c[0], str) else (c[1] if len(c) > 1 and isinstance(c[1], str) else \\\"\\\")\\n    if not isinstance(c, str):\\n        return None\\n    lines = [l for l in c.splitlines() if l.strip()]\\n    if not lines:\\n        return None\\n    m = re.search(r\\\"([a-z]+(?:-[a-z]+){2}-\\\\d{2})\\\\s*$\\\", lines[-1])\\n    return m.group(1) if m else None\\n\\n\\ntry:\\n    from lib import decode\\n    decode.register_free(\\\"rot47\\\", 15, lambda p: [_rot47(p)])\\n    decode.register_free(\\\"morsehex\\\", 16, lambda p: [x for x in [_morsehex(p)] if x])\\n    decode.register_free(\\\"baconhex\\\", 17, lambda p: [x for x in [_baconhex(p)] if x])\\nexcept Exception:  # noqa: BLE001\\n    decode = None\\n\\n\\ndef fallback(answer_id, question, data, contract):\\n    \\\"\\\"\\\"Called ONLY when answer() found nothing (None or an exception): a cheap generic second try for a variant shape\\n    the direct parse doesn't know (Time Trial / Mastery mutate the task) -- e.g. the lane lib's name-agnostic decoder\\n    over `data`, then a match against question[\\\"answer_format\\\"]. None = give up on this field only.\\\"\\\"\\\"\\n    return None\\n\\n\\ndef _past_deadline():\\n    \\\"\\\"\\\"The timed runner's HCTF_SOLVE_DEADLINE (epoch) has passed: print the answers found so far instead.\\\"\\\"\\\"\\n    try:\\n        return time.time() > float(os.environ[\\\"HCTF_SOLVE_DEADLINE\\\"])\\n    except (KeyError, ValueError):\\n        return False\\n\\n\\ndef _solve_pairs(job):\\n    \\\"\\\"\\\"Answer one group of (answer_id, question) pairs -- a whole Mastery set, or the whole contract.\\\"\\\"\\\"\\n    root, contract, pairs = job\\n    out = {}\\n    for aid, q in pairs:\\n        data = artifact_bytes(root, contract, q.get(\\\"artifact\\\") or \\\"\\\")\\n        try:\\n            v = answer(aid, q, data, contract)\\n        except Exception as e:  # noqa: BLE001 - one bad field must not sink the other answers\\n            print(f\\\"{aid}: {e!r}\\\", file=sys.stderr)\\n            v = None\\n        if v is None and not _past_deadline():   # in-window: never let a fallback search eat the kill margin\\n            try:\\n                v = fallback(aid, q, data, contract)\\n            except Exception as e:  # noqa: BLE001\\n                print(f\\\"{aid}: fallback {e!r}\\\", file=sys.stderr)\\n        if v is not None:\\n            out[aid] = normalize(v, q)\\n    return out\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--contract\\\", required=True)\\n    ap.add_argument(\\\"--artifacts\\\", required=True)\\n    a = ap.parse_args()\\n    contract, pairs = load_contract(a.contract)\\n    groups = group_by_set(pairs)\\n    out = {}\\n    if len(groups) >= 2 and os.environ.get(\\\"HCTF_SOLVER_PARALLEL\\\", \\\"1\\\") != \\\"0\\\":\\n        # Mastery: every set runs inside ONE clock -- one forked process per set (the Homebase VM has 2 vCPUs; heavy\\n        # per-set work such as unzipping 31 MB deliveries halves). Same results as the sequential loop.\\n        import multiprocessing as mp\\n        from concurrent.futures import ProcessPoolExecutor\\n        try:\\n            with ProcessPoolExecutor(max_workers=min(len(groups), os.cpu_count() or 2),\\n                                     mp_context=mp.get_context(\\\"fork\\\")) as ex:\\n                for part in ex.map(_solve_pairs, [(a.artifacts, contract, g) for g in groups.values()]):\\n                    out.update(part)\\n        except Exception as e:  # noqa: BLE001 - never lose a solve to the pool: fall back to sequential\\n            print(f\\\"parallel sets failed ({e!r}); sequential\\\", file=sys.stderr)\\n            out = _solve_pairs((a.artifacts, contract, pairs))\\n    else:\\n        out = _solve_pairs((a.artifacts, contract, pairs))\\n    print(json.dumps(out))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\nsolver/cases/auto-mastery-81f42697:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-mastery-bb73672b:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-time_trial-8790e0e1:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-time_trial-8c6bc748:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/auto-time_trial-ddaa56a0:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/single_solve:\\nartifacts\\ncontract.json\\nexpected.json\\n\\nsolver/cases/variant-mastery-f9ac3fc4:\\nartifacts\\ncontract.json\\nexpected.json\\ngm_feedback.json\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":fa