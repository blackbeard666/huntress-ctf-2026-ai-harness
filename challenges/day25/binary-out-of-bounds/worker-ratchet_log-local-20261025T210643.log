 (same carrier rule as JAR), methods/method_count/access_flags from that class; primary class = name or SourceFile stem matching the unit the question names. Fixtures: javac single class + a 3-class jar without Main-Class.\"}\n]\nfor g in new:\n    assert g[\"id\"] not in by\ngaps=[by[g[\"id\"]] for g in gaps]\n# insert new gaps: p1 ones at top, p2 ones after the last p1\np1=[g for g in new if g[\"priority\"]==1]; p2=[g for g in new if g[\"priority\"]==2]\ngaps=p1+gaps\n# stable-sort by priority\ngaps=sorted(gaps,key=lambda g:g[\"priority\"])\nidx=max(i for i,g in enumerate(gaps) if g[\"priority\"]==2)\ngaps=gaps[:idx+1]+p2+gaps[idx+1:] if False else gaps\n# place p2 new right after p1 block\nfirst2=next(i for i,g in enumerate(gaps) if g[\"priority\"]==2)\ngaps=gaps[:first2]+p2+gaps[first2:]\nbody=\"[\\n\"+\",\\n\".join(\"  \"+json.dumps(g,ensure_ascii=False) for g in gaps)+\"\\n]\"\njson.loads(body)\ns=s[:m.start(2)]+body+s[m.end(2):]\nopen(p,\"w\").write(s)\nst=json.load(open(\".run/prebuild-state.json\"))\npend=[g[\"id\"] for g in gaps if g[\"action\"]==\"prebuild\" and not ((v:=st.get(\"binary-reverse-engineering:\"+g[\"id\"])) and (v.get(\"ok\") or v.get(\"attempts\",0)>=2))]\nprint(len(gaps), len(pend), pend)\nprint([ (g[\"id\"],g[\"priority\"]) for g in gaps if g[\"priority\"]==1])\nEOF"}}}
