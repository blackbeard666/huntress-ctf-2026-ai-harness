{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q5zhaE8LqrmoNAqYyRgn3L","type":"tool_result","content":"\"\"\"Per-lane field playbooks: the GM's label GRAMMAR per field family.\n\nThe dominant failure on the binary and script lanes is not analysis, it is spelling the GM's synthetic\nlabel (e.g. `pe_cli`, `if_guard`, `.text$<sym>`) under coarse per-set feedback. `lib/knowledge.py` holds the\nconfirmed VALUES and `lib/vocab.json` the confirmed label lists; this module adds, per (lane, field-family):\nthe derivation RULE, the known-REJECTED spellings, and worked examples, and exposes them to the two consumers\nthat need them up front:\n\n  - for_lane(lane)                         -> markdown block injected into the worker prompts (point: start\n                                              from the rule, not blind synonyms)\n  - entry_for(lane, aid)                   -> the PlaybookEntry matching a field by its ending, or None\n  - rejected(lane, aid)                    -> spellings already proven wrong for this family (never reprobe)\n  - seed_candidates(lane, aid, terms, v)   -> high-priority label candidates for `hctf labels`, built from the\n                                              rule (closed vocab, or container+runtime / keyword+ending compounds)\n\nSingle source of truth for the confirmed values stays in lib/knowledge.py (imported below). Add a new family\nhere the moment the GM confirms one, next to the knowledge.py entry.\n\"\"\"\nimport re\nfrom dataclasses import dataclass, field\n\nfrom . import knowledge as K\n\nBINARY = \"binary-reverse-engineering\"\nSCRIPT = \"script-analysis\"\nMETADATA = \"metadata-forensics\"\n\n\ndef field_family(aid):\n    \"\"\"Group fields by their trailing token: 'batch-launcher-control'->'control', 'd03_analysis_format'->'format',\n    'set2.cpp-mangled_score_symbol'->'symbol'. Mirrors hctf.labels.ending so the resolver and playbook agree.\"\"\"\n    last = str(aid).rsplit(\".\", 1)[-1]\n    parts = [p for p in re.split(r\"[-_]\", last) if p]\n    return parts[-1].lower() if parts else last.lower()\n\n\n@dataclass\nclass PlaybookEntry:\n    lanes: tuple           # lanes this applies to\n    families: tuple        # field-family endings (field_family(aid)) it covers\n24:BINARY = \"binary-reverse-engineering\"\n25:SCRIPT = \"script-analysis\"\n26:METADATA = \"metadata-forensics\"\n29:def field_family(aid):\n49:def _symbol_derive(terms, solver_value):\n61:def _vbs_control_derive(terms, solver_value):\n74:def _hex_width_derive(terms, solver_value):\n85:PLAYBOOK = [\n319:def entries_for_lane(lane):\n323:def entry_for(lane, aid):\n331:def rejected(lane, aid):\n339:def seed_candidates(lane, aid, terms=(), solver_value=None):\n353:ENUM_NOTE = (\n364:NAMING_LAWS = (\n389:def for_lane(lane):\n8:ELF_ENDIANNESS = {\"ELFDATA2LSB\": \"little\", \"ELFDATA2MSB\": \"big\"}        # GM rejected \"little endian\"\n9:ELF_MACHINE = {\"EM_X86_64\": \"x86-64\", \"EM_386\": \"x86\", \"EM_AARCH64\": \"AArch64\", \"EM_ARM\": \"ARM\"}  # not \"EM_X86_64\"\n10:ELF_CLASS = {\"ELFCLASS32\": \"ELF32\", \"ELFCLASS64\": \"ELF64\"}             # readelf style, not \"ELFCLASS64\"\n13:ELF_CLASS_BITS = {\"ELFCLASS32\": \"32\", \"ELFCLASS64\": \"64\"}\n14:ELF_TYPE_AS_IS = True   # e_type submitted as the constant, e.g. \"ET_EXEC\" (not \"EXEC\")\n22:BINARY_FORMAT = {\"ELF\": \"elf\", \"PE\": \"pe\", \"MACHO\": \"macho\"}\n30:PE_MACHINE = {0x14c: \"i386\", 0x8664: \"x86-64\", 0xaa64: \"AArch64\", 0x1c0: \"ARM\"}  # PE FILE_HEADER.Machine; \"x86\" REJECTED for a PE32 i386 .NET assembly; x86-64 GM-confirmed on c_machine/slot*_machine (the lib copy lacked it -> from-scratch replay emitted \"0x8664\" and failed binary TT twice)\n41:DOTNET_FORMAT = \"pe_cli\"\n44:ARCHITECTURE_USES_MACHINE_VOCAB = True\n45:ARCHITECTURE_REJECTED = [\"amd64\"]\n67:HCFG_OFFSET_FMT = \"{n}\"\n68:HCFG_OFFSET_RAW = \"offset of the b'HCFG' magic\"     # base64 form: offset of the first base64 char (D9/D11/D13)\n73:JAR_FORMAT = \"jar\"\n74:JAR_FORMAT_REJECTED = [\"jar_jvm\"]\n75:DOTNET_FORMAT_REJECTED = [\n90:BINARY_MEMBER_QUALIFIERS = {\"stripped\": False, \"symbolized\": True, \"unstripped\": True}   # -> has .symtab\n106:HCFG_STORAGE = {\"base64\": \"base64\", \"raw_hcfg_section\": \"raw_hcfg_section\", \"raw_const_array\": \"raw_const_array\",\n110:HCFG_STORAGE_REJECTED = [\n115:HCFG_CODE_SECTIONS = {\".text\", \".init\", \".fini\", \".plt\", \".plt.got\", \".plt.sec\"}\n116:RECOVER_CODE_ABSENT = \"none\"\n117:RECOVER_CODE_REJECTED = [\"8114\"]\n138:JPEG_DIMENSIONS_FMT = \"{width}x{height}\"\n142:PNG_DIMENSIONS_FMT = \"{width}x{height}\"\n146:PDF_HEADER_VERSION_FMT = \"{major}.{minor}\"\n152:ZIP_EOCD_TOTAL_ENTRIES_FMT = \"{n}\"\n158:ZIP_CD_MEMBER_NAMES_FMT = {\"separators\": (\",\", \":\")}   # json.dumps(names, **FMT); non-ASCII names not seen yet\n172:PE_ENTRY_POINT_RVA_HEX_FMT = \"0x{:08x}\"\n173:PE_ENTRY_POINT_RVA_HEX_REJECTED = [\"0x65bd0\"]\n180:PE_VERSION_STRING_KEY = {\"original-filename\": \"OriginalFilename\"}\n187:DOTNET_MVID_GUID = \"str(uuid.UUID(bytes_le=...))\"\n195:MSI_PRODUCT_CODE_GUID = \"Property['ProductCode'] verbatim\"\n196:MSI_PRODUCT_CODE_GUID_REJECTED = [\"DD1A80D5-0250-4F4D-B289-13096D633C61\"]\n203:LNK_TARGET_PATH_WINDOWS = \"LinkInfo LocalBasePath (+CommonPathSuffix) verbatim, else the IDList path\"\n211:OOXML_EXTERNAL_RELATIONSHIP_TARGETS = \"sorted(Target for TargetMode=External in every *.rels)\"\n212:OOXML_EXTERNAL_RELATIONSHIP_TARGETS_REJECTED = ['[\"https://example.test/evidence/d87ca62c5bb7\",\"https://example.test/control\"]']\n216:METADATA_SYNTHESIS_DIGEST_ORDER = \"sorted(Files, key=hexdigest(member bytes)) ascending\"\n223:EMAIL_MESSAGE_ID = \"Message-ID header verbatim, <> kept\"\n224:EMAIL_MESSAGE_ID_REJECTED = [\"artifact-assembly-line@example.test\", \"none\"]\n231:MACHO_CPU_TYPE_SET = 'json([\"0x%08x\" % cputype for each fat_arch slice, else the thin header])'\n232:MACHO_CPU_TYPE_SET_REJECTED = ['[\"arm64\"]']\n235:SCENARIO_ATTACK = {\n242:BOOL = {True: \"true\", False: \"false\"}\n246:JSCRIPT_ROLE_ATTACK_CONFIRMED = {\n253:JSCRIPT_ATTACK_REJECTED = {\"launcher\": [\"T1218.010\"], \"stager\": [\"T1059.007\", \"T1620\"], \"dropper\": [\"T1105\", \"T1027.009\"]}\n257:BATCH_ROLE_ATTACK_CONFIRMED = {\n266:BATCH_EXPANSION_VOCAB = (\"percent\", \"delayed\", \"call_double\", \"for_indirect\")\n274:BATCH_EXPANSION_STATEMENT_RULE = {\"for\": \"for_indirect\", \"call_set_h\": \"call_double\", \"call_set\": \"percent\",\n276:BATCH_EXPANSION_STATEMENT_REJECTED = {\"for_h\": [\"call_double\"], \"percent\": [\"delayed\"]}\n281:BATCH_EXPANSION_STATEMENT_SINCE = \"2026-10-16\"\n288:BATCH_CONTROL_VOCAB = (\"direct\", \"errorlevel_guard\", \"goto_dispatch\", \"call_subroutine\", \"if_guard\")\n293:BATCH_DEFINED_GUARD_REJECTED = (\"if_defined\", \"if defined\", \"defined_guard\", \"if_defined_guard\", \"flag_guard\",\n295:BATCH_DEFINED_GUARD_CANDIDATES = (\"environment_guard\", \"env_guard\", \"ready_flag\", \"ready_guard\", \"sentinel_guard\",\n304:VBS_ROLE_ATTACK_CONFIRMED = {\n313:VBS_CONTROL_VOCAB = (\"direct\", \"select_case\", \"do_once\", \"while_once\", \"for_once\")\n322:VBS_CONTROL_ON_ERROR_CONFIRMED = \"error_guard\"\n323:VBS_CONTROL_ON_ERROR_REJECTED = (\"direct\", \"on_error_resume\")\n324:VBS_CONTROL_ON_ERROR_CANDIDATES = (\"error_guard\", \"on_error_guard\", \"err_guard\", \"on_error_resume_next\", \"on_error\",\n326:VBS_CONTROL_ON_ERROR = VBS_CONTROL_ON_ERROR_CONFIRMED\n329:VBS_CONTROL_FOR_ONCE_CANDIDATES = (\"for_once\", \"for_next\", \"for_loop\")\n330:VBS_CONTROL_FOR_ONCE = VBS_CONTROL_FOR_ONCE_CANDIDATES[0]","is_error":false}]},"parent_tool_use_id":null,"session_id":"cd6e6acb-75d1-49cf-8da4-c3379eb4e6e0","uuid":"1eaf5667-4435-452b-81ee-995fd39ee8cd","timestamp":"2026-10-21T13:22:10.390Z","tool_use_result":{"stdout":"\"\"\"Per-lane field playbooks: the GM's label GRAMMAR per field family.\n\nThe dominant failure on the binary and script lanes is not analysis, it is spelling the GM's synthetic\nlabe