lib.web.solve_target` refetches /api/clues; accept a pre-fetched clues dict.\n{\n  \"b450ba0d-c60f-4df7-9b94-b99fc4dba469\": {\n    \"proof-1\": \"proof_da211f5978c54caf9d74c3a86558d4e1\"\n  }\n}{\n  \"22ca7e5c-bce3-42b7-bafd-75d35abbb204\": {\n    \"proof-1\": \"proof_a17b7e61723d42579c99b059cd91599e\"\n  }\n}{\n  \"8844b651-f414-4b36-9561-caec6069065f\": {\n    \"proof-3\": \"proof_da1d6d6a926946cab455d6ae2ae3a94d\",\n    \"proof-2\": \"proof_da40159f92dd4bdfb01b71051fcf1a72\",\n    \"proof-1\": \"proof_26795dfbe6834ca79f73123806703548\"\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Nmk51scj7VF9PR4jADkZuy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
