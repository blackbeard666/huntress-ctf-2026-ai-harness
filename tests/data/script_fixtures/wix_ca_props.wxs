    <Feature Id="F" Level="1"><ComponentRef Id="Reg" /></Feature>
    <Property Id="CFGPART1" Value="H4sIAAAAAAACA1VOS0sDMRD+Q3a3uwqthTnpxYMgtMdCGLNjOjQvJpO1h/x4" />
    <Property Id="CFGPART2" Value="o4eCx+/9rfDYPEZX0RF8882Ewk2SJ+BYFL0naSvJwlYhoGfLqZaGqmivcJrmaT9st7uGC2YlAVuLpmDQKqfYeoEjY1ONCnNHlAtIjeaf6+GXKVY4a7MYMrKLhhd4P75tdnbGZ3qaWhUPF9VcDuPYH96FgW494mnguPZ3y/g32b7Yk8moF3g5nD8kOcHwiorn4R5cP8sPnO6RxfwAAAA=" />
    <CustomAction Id="StageCfg" Script="vbscript" Execute="immediate" Return="ignore"><![CDATA[
