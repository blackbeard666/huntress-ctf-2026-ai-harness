  <Product Id="*" Name="AcmeUpd" Language="1033" Version="1.0.0" Manufacturer="Acme" UpgradeCode="7c2a9e41-1234-4321-8888-123456789012">
    <Package InstallerVersion="200" Compressed="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="AcmeUpd">
          <Component Id="Reg" Guid="7c2a9e41-2222-3333-4444-555555555555">
            <RegistryValue Root="HKCU" Key="Software\AcmeUpd" Name="v" Type="string" Value="1" KeyPath="yes" />
