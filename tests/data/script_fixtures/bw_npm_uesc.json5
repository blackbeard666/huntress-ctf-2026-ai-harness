  "huntress": {
    "descriptor": "\u0076\u003d\u0033\u007c\u006c\u0061\u006e\u0067\u0075\u0061\u0067\u0065\u003d\u006e\u006f\u0064\u0065\u007c\u0072\u006f\u006c\u0065\u003d\u006c\u0061\u0075\u006e\u0063\u0068\u0065\u0072\u007c\u0076\u0065\u0072\u0064\u0069\u0063\u0074\u003d\u0073\u0075\u0073\u0070\u0069\u0063\u0069\u006f\u0075\u0073\u007c\u0061\u0074\u0074\u0061\u0063\u006b\u003d\u0054\u0031\u0030\u0035\u0039\u007c\u0061\u0064\u0061\u0070\u0074\u0065\u0072\u003d\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u005f\u0073\u0070\u0061\u0077\u006e\u007c\u0068\u006f\u0073\u0074\u005f\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u003d\u006e\u0070\u006d\u005f\u006c\u0069\u0066\u0065\u0063\u0079\u0063\u006c\u0065\u007c\u006f\u0062\u0066\u0075\u0073\u0063\u0061\u0074\u0069\u006f\u006e\u005f\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u003d\u0070\u006c\u0061\u0069\u006e\u007c\u0073\u0074\u0061\u0067\u0065\u005f\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u003d\u0073\u0069\u006e\u0067\u006c\u0065\u005f\u0073\u0074\u0061\u0067\u0065\u007c\u006e\u0065\u0078\u0074\u005f\u006c\u0061\u006e\u0067\u0075\u0061\u0067\u0065\u003d\u0073\u0068\u007c\u0063\u0061\u006d\u0070\u0061\u0069\u0067\u006e\u005f\u0069\u0064\u003d\u004e\u0050\u002d\u0063\u0031\u0033\u0061\u0037\u0066\u0039\u0030\u007c\u0075\u0072\u006c\u003d\u0068\u0074\u0074\u0070\u0073\u003a\u002f\u002f\u006e\u0070\u002d\u0063\u0031\u0033\u0061\u0037\u0066\u0039\u0030\u002e\u0065\u0078\u0061\u006d\u0070\u006c\u0065\u002e\u0069\u006e\u0076\u0061\u006c\u0069\u0064\u002f\u0073\u0074\u0061\u0067\u0065\u007c\u0066\u0069\u006c\u0065\u005f\u0070\u0061\u0074\u0068\u003d\u002f\u0074\u006d\u0070\u002f\u0068\u0075\u006e\u0074\u0072\u0065\u0073\u0073\u002d\u006e\u0070\u002d\u0063\u0031\u0033\u0061\u0037\u0066\u0039\u0030\u002f\u002e\u0073\u0074\u0061\u0067\u0065"
