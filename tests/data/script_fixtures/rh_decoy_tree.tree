{
 ".devcontainer/devcontainer.json": "{\"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\", \"features\": {}}\n",
 ".git/config": "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n",
 ".git/hooks/pre-commit.sample": "#!/bin/sh\nexit 0\n",
 ".gitattributes": "*.txt text eol=lf\n*.png binary\n",
 ".vscode/tasks.json": "{\"version\": \"2.0.0\", \"tasks\": [{\"label\": \"build\", \"type\": \"shell\", \"command\": \"make\"}]}\n",
 "README.md": "# readme\nRun `git config core.hooksPath .githooks` to enable hooks.\n"
}